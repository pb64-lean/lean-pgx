"""Primary lean-pgx library target."""

load("@rules_lean//lean:defs.bzl", "lean_library")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pg_typed",
    actual = "//lean/Pgx:pg_typed",
)

lean_library(
    name = "pgx",
    srcs = ["Pgx.lean"],
    deps = [
        ":pg_typed",
        "//lean/Pgx:core",
        "//lean/Pgx/Constraint:semantics",
    ],
    strip_module_prefix = "lean",
)
