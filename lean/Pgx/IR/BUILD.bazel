"""Serialization support for the canonical PostgreSQL IR."""

load("@rules_lean//lean:defs.bzl", "lean_library")

package(default_visibility = ["//visibility:private"])

lean_library(
    name = "core",
    srcs = ["Core.lean"],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "json",
    srcs = ["Json.lean"],
    deps = ["//lean/Pgx:ir"],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)
