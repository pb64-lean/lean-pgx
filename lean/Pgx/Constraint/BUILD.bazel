"""Typed local PostgreSQL constraint IR."""

load("@rules_lean//lean:defs.bzl", "lean_library")

package(default_visibility = ["//visibility:public"])

lean_library(
    name = "ir",
    srcs = ["IR.lean"],
    deps = ["//lean/Pgx/IR:core"],
    strip_module_prefix = "lean",
)

lean_library(
    name = "semantics",
    srcs = ["Semantics.lean"],
    deps = [":ir"],
    strip_module_prefix = "lean",
)
