import Pgx.Codegen.ConstraintParser
import Pgx.Codegen.Identifier
import Pgx.Codegen.Projection
import Pgx.Constraint.Semantics
import Pgx.TypeMapping
import Pgx.Typed

/-!
# Pure Lean source emission

`emitDatabase` is deliberately independent of the filesystem and PostgreSQL.
It validates a normalized `DatabaseIR` and returns every declared generated
source as data.  The build rule is responsible only for writing those values
to its declared outputs.
-/

namespace Pgx.Codegen

open Pgx.Codegen.Identifier

inductive CodegenError where
  | invalidModulePrefix (value reason : String)
  | malformedIR (context reason : String)
  | duplicateType (key : Pgx.TypeKey)
  | duplicateRelation (key : Pgx.RelationKey)
  | duplicateQuery (name : String)
  | unsupportedType (key : Pgx.TypeKey) (context : String)
  | unsupportedConstraint (context reason : String)
  | cyclicDomain (key : Pgx.TypeKey)
  | cyclicType (key : Pgx.TypeKey)
  deriving Repr, BEq, Inhabited

namespace CodegenError

def toMessage : CodegenError → String
  | .invalidModulePrefix value reason =>
      s!"invalid generated module prefix {repr value}: {reason}"
  | .malformedIR context reason => s!"invalid {context}: {reason}"
  | .duplicateType key => s!"duplicate PostgreSQL type in generation IR: {key}"
  | .duplicateRelation key => s!"duplicate PostgreSQL relation in generation IR: {key}"
  | .duplicateQuery name => s!"duplicate generated query name: {name}"
  | .unsupportedType key context =>
      s!"unsupported PostgreSQL type {key} while generating {context}"
  | .unsupportedConstraint context reason =>
      s!"unsupported local constraint while generating {context}: {reason}"
  | .cyclicDomain key => s!"cyclic PostgreSQL domain base chain at {key}"
  | .cyclicType key => s!"cyclic generated PostgreSQL type dependency at {key}"

end CodegenError

instance : ToString CodegenError := ⟨CodegenError.toMessage⟩

/-- One generated Lean module and its repository-relative output path. -/
structure GeneratedSource where
  path : String
  moduleName : String
  contents : String
  deriving Repr, BEq, Inhabited

/-- The fixed generated output partition.  Query modules vary only with the
declared query inputs; catalog-discovered objects remain in the three fixed
schema modules. -/
structure GeneratedSources where
  modulePrefix : String
  types : GeneratedSource
  schema : GeneratedSource
  constraints : GeneratedSource
  queries : Array GeneratedSource
  root : GeneratedSource
  deriving Repr, BEq, Inhabited

namespace GeneratedSources

def all (sources : GeneratedSources) : Array GeneratedSource :=
  #[sources.types, sources.schema, sources.constraints] ++ sources.queries ++ #[sources.root]

def findModule? (sources : GeneratedSources) (moduleName : String) : Option GeneratedSource :=
  sources.all.find? (fun source => source.moduleName == moduleName)

end GeneratedSources

private structure NamedType where
  key : Pgx.TypeKey
  leanType : String
  codec : String

private structure NamedSchema where
  source : String
  leanName : String

private structure NamedRelation where
  key : Pgx.RelationKey
  schemaName : String
  relationName : String

private structure NamedQuery where
  query : Pgx.QueryIR
  moduleName : String

private structure NamingPlan where
  modulePrefix : String
  prefixPath : String
  types : Array NamedType
  schemas : Array NamedSchema
  relations : Array NamedRelation
  queries : Array NamedQuery

private structure TypeUse where
  leanType : String
  codec : Option String := none
  deriving Inhabited

private def generatedHeader : String :=
  "/- This file is generated by lean-pgx.  Do not edit it directly. -/"

private def sourceText (lines : List String) : String :=
  String.intercalate "\n" lines ++ "\n"

private def commaSep (values : Array String) : String :=
  String.intercalate ", " values.toList

private def arrayExpr (values : Array String) : String :=
  "#[" ++ commaSep values ++ "]"

private def recordExpr (body : String) : String :=
  "{ " ++ body ++ " }"

private def optionExpr (value : Option String) : String :=
  match value with
  | none => "none"
  | some value => "some (" ++ value ++ ")"

private def boolExpr (value : Bool) : String :=
  if value then "true" else "false"

private def sortStrings (values : Array String) : Array String :=
  values.toList.mergeSort (fun left right => compare left right == .lt) |>.toArray

private def sortTypeKeys (values : Array Pgx.TypeKey) : Array Pgx.TypeKey :=
  values.toList.mergeSort (fun left right =>
    compare left.display right.display == .lt) |>.toArray

private def pushUnique [BEq α] (values : Array α) (value : α) : Array α :=
  if values.contains value then values else values.push value

private def firstDuplicateList? [BEq α] : List α → Option α
  | [] => none
  | value :: rest => if rest.contains value then some value else firstDuplicateList? rest

private def firstDuplicate? [BEq α] (values : Array α) : Option α :=
  firstDuplicateList? values.toList

private def normalizePrefix (value : String) : Except CodegenError (String × String) := do
  if value.isEmpty then
    throw (.invalidModulePrefix value "the prefix is empty")
  let components := value.splitOn "."
  if components.any String.isEmpty then
    throw (.invalidModulePrefix value "empty dot-separated component")
  let components := components.map (fun component => upperCamel component "Generated")
  pure (String.intercalate "." components, String.intercalate "/" components)

private def typeKeyExpr (key : Pgx.TypeKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}, kind := .{key.kind.tag}"

private def typeRefExpr (ref : Pgx.TypeRef) : String :=
  let typmod := ref.typmod.map (fun value => toString value)
  recordExpr s!"key := {typeKeyExpr ref.key}, typmod := {optionExpr typmod}"

private def relationKeyExpr (key : Pgx.RelationKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def columnKeyExpr (key : Pgx.ColumnKey) : String :=
  recordExpr s!"relation := {relationKeyExpr key.relation}, name := {stringLiteral key.name}"

private def collationKeyExpr (key : Pgx.CollationKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def compositeFieldExpr (field : Pgx.CompositeFieldIR) : String :=
  let collation := optionExpr (field.collation.map collationKeyExpr)
  recordExpr s!"name := {stringLiteral field.name}, ordinal := {field.ordinal}, ty := {typeRefExpr field.ty}, collation := {collation}"

private def typeDescExpr (db : Pgx.DatabaseIR) (key : Pgx.TypeKey) : String :=
  match db.enum? key with
  | some value =>
      let labels := arrayExpr (value.labels.map stringLiteral)
      recordExpr s!"key := {typeKeyExpr key}, enumLabels := {labels}"
  | none =>
      match db.domain? key with
      | some value =>
          recordExpr s!"key := {typeKeyExpr key}, base := some ({typeRefExpr value.base}), notNull := {boolExpr value.notNull}"
      | none =>
          match db.array? key with
          | some value =>
              recordExpr s!"key := {typeKeyExpr key}, arrayElement := some ({typeRefExpr value.element}), arrayDelimiter := some ({stringLiteral value.delimiter})"
          | none =>
              match db.composite? key with
              | some value =>
                  let fields := arrayExpr (value.fields.map compositeFieldExpr)
                  recordExpr s!"key := {typeKeyExpr key}, compositeFields := {fields}"
              | none =>
                  match db.range? key with
                  | some value =>
                      recordExpr s!"key := {typeKeyExpr key}, rangeSubtype := some ({typeRefExpr value.subtype}), rangeMultirange := some ({typeKeyExpr value.multirange})"
                  | none =>
                      match db.multirange? key with
                      | some value =>
                          recordExpr s!"key := {typeKeyExpr key}, multirangeRange := some ({typeKeyExpr value.range})"
                      | none => recordExpr s!"key := {typeKeyExpr key}"

private def sessionExpr (session : Pgx.SessionContract) : String :=
  let searchPath := arrayExpr (session.searchPath.map stringLiteral)
  recordExpr s!"searchPath := {searchPath}, timezone := {stringLiteral session.timezone}, encoding := {stringLiteral session.encoding}, standardConformingStrings := {boolExpr session.standardConformingStrings}"

private def staticColumnExpr (column : Pgx.RelationColumnIR) : String :=
  recordExpr s!"name := {stringLiteral column.name}, ordinal := {column.ordinal}, ty := {typeRefExpr column.ty}, nullable := {boolExpr column.nullable}"

private def relationKindExpr : Pgx.RelationKind → String
  | .table => "table"
  | .partitionedTable => "partitionedTable"
  | .view => "view"
  | .materializedView => "materializedView"
  | .foreignTable => "foreignTable"

private def staticRelationExpr (relation : Pgx.RelationIR) : String :=
  let columns := arrayExpr (relation.columns.map staticColumnExpr)
  recordExpr s!"key := {relationKeyExpr relation.key}, kind := .{relationKindExpr relation.kind}, columns := {columns}"

private def constraintKindExpr : Pgx.ConstraintKind → String
  | .check => "check"
  | .notNull => "notNull"
  | .primaryKey => "primaryKey"
  | .unique => "unique"
  | .foreignKey => "foreignKey"
  | .exclusion => "exclusion"

private def scalarKindExpr : Pgx.Constraint.ScalarKind → String
  | .boolean => "Pgx.Constraint.ScalarKind.boolean"
  | .int16 => "Pgx.Constraint.ScalarKind.int16"
  | .int32 => "Pgx.Constraint.ScalarKind.int32"
  | .int64 => "Pgx.Constraint.ScalarKind.int64"
  | .numeric => "Pgx.Constraint.ScalarKind.numeric"
  | .text => "Pgx.Constraint.ScalarKind.text"
  | .enumeration key =>
      "Pgx.Constraint.ScalarKind.enumeration (" ++ typeKeyExpr key ++ ")"

private def scalarTypeExpr (ty : Pgx.Constraint.ScalarType) : String :=
  recordExpr s!"declared := {typeRefExpr ty.declared}, base := {scalarKindExpr ty.base}, domains := {arrayExpr (ty.domains.map typeKeyExpr)}"

private def literalExpr : Pgx.Constraint.Literal → String
  | .null => "Pgx.Constraint.Literal.null"
  | .boolean value => s!"Pgx.Constraint.Literal.boolean {boolExpr value}"
  | .integer value => s!"Pgx.Constraint.Literal.integer ({value})"
  | .numeric value => s!"Pgx.Constraint.Literal.numeric {stringLiteral value}"
  | .text value => s!"Pgx.Constraint.Literal.text {stringLiteral value}"
  | .enumeration key label =>
      s!"Pgx.Constraint.Literal.enumeration ({typeKeyExpr key}) {stringLiteral label}"

private def castPreservationExpr : Pgx.Constraint.CastPreservation → String
  | .identity => "identity"
  | .domain => "domain"
  | .integerWiden => "integerWiden"
  | .exactNumeric => "exactNumeric"
  | .textRepresentation => "textRepresentation"
  | .enumLiteral => "enumLiteral"

private partial def valueExprExpr : Pgx.Constraint.ValueExpr → String
  | .column name ty nullable =>
      s!"Pgx.Constraint.ValueExpr.column {stringLiteral name} ({scalarTypeExpr ty}) {boolExpr nullable}"
  | .domainValue ty nullable =>
      s!"Pgx.Constraint.ValueExpr.domainValue ({scalarTypeExpr ty}) {boolExpr nullable}"
  | .literal value ty =>
      s!"Pgx.Constraint.ValueExpr.literal ({literalExpr value}) ({scalarTypeExpr ty})"
  | .cast preservation value target =>
      s!"Pgx.Constraint.ValueExpr.cast .{castPreservationExpr preservation} ({valueExprExpr value}) ({scalarTypeExpr target})"
  | .neg value result =>
      s!"Pgx.Constraint.ValueExpr.neg ({valueExprExpr value}) ({scalarTypeExpr result})"
  | .add left right result =>
      s!"Pgx.Constraint.ValueExpr.add ({valueExprExpr left}) ({valueExprExpr right}) ({scalarTypeExpr result})"
  | .sub left right result =>
      s!"Pgx.Constraint.ValueExpr.sub ({valueExprExpr left}) ({valueExprExpr right}) ({scalarTypeExpr result})"
  | .charLength value result =>
      s!"Pgx.Constraint.ValueExpr.charLength ({valueExprExpr value}) ({scalarTypeExpr result})"
  | .btrim value result =>
      s!"Pgx.Constraint.ValueExpr.btrim ({valueExprExpr value}) ({scalarTypeExpr result})"
  | .position substring string result =>
      s!"Pgx.Constraint.ValueExpr.position ({valueExprExpr substring}) ({valueExprExpr string}) ({scalarTypeExpr result})"

private def comparisonExprName : Pgx.Constraint.Comparison → String
  | .eq => "eq"
  | .ne => "ne"
  | .lt => "lt"
  | .le => "le"
  | .gt => "gt"
  | .ge => "ge"

private partial def truthExprExpr : Pgx.Constraint.TruthExpr → String
  | .constant value =>
      let value := optionExpr (value.map boolExpr)
      s!"Pgx.Constraint.TruthExpr.constant {value}"
  | .fromBoolean value =>
      s!"Pgx.Constraint.TruthExpr.fromBoolean ({valueExprExpr value})"
  | .compare operator left right =>
      s!"Pgx.Constraint.TruthExpr.compare .{comparisonExprName operator} ({valueExprExpr left}) ({valueExprExpr right})"
  | .isNull value => s!"Pgx.Constraint.TruthExpr.isNull ({valueExprExpr value})"
  | .isNotNull value => s!"Pgx.Constraint.TruthExpr.isNotNull ({valueExprExpr value})"
  | .and left right =>
      s!"Pgx.Constraint.TruthExpr.and ({truthExprExpr left}) ({truthExprExpr right})"
  | .or left right =>
      s!"Pgx.Constraint.TruthExpr.or ({truthExprExpr left}) ({truthExprExpr right})"
  | .not value => s!"Pgx.Constraint.TruthExpr.not ({truthExprExpr value})"

private def constraintExpr (constraint : Pgx.ConstraintIR) : String :=
  let columns := arrayExpr (constraint.columns.map stringLiteral)
  let referencedRelation := optionExpr (constraint.referencedRelation.map relationKeyExpr)
  let referencedColumns := arrayExpr (constraint.referencedColumns.map stringLiteral)
  let expression := optionExpr (constraint.expression.map stringLiteral)
  let localExpression := optionExpr (constraint.localExpression.map truthExprExpr)
  recordExpr s!"relation := {relationKeyExpr constraint.relation}, name := {stringLiteral constraint.name}, kind := .{constraintKindExpr constraint.kind}, columns := {columns}, referencedRelation := {referencedRelation}, referencedColumns := {referencedColumns}, expression := {expression}, localExpression := {localExpression}, validated := {boolExpr constraint.validated}"

private def indexExpr (index : Pgx.IndexIR) : String :=
  let columns := arrayExpr (index.columns.map stringLiteral)
  let predicate := optionExpr (index.predicate.map stringLiteral)
  let expression := optionExpr (index.expression.map stringLiteral)
  recordExpr s!"relation := {relationKeyExpr index.relation}, name := {stringLiteral index.name}, unique := {boolExpr index.unique}, primary := {boolExpr index.primary}, valid := {boolExpr index.valid}, columns := {columns}, predicate := {predicate}, expression := {expression}"

private def viewCheckOptionExpr : Pgx.ViewCheckOption → String
  | .none => "none"
  | .local => "local"
  | .cascaded => "cascaded"

private def viewExpr (view : Pgx.ViewIR) : String :=
  recordExpr s!"relation := {relationKeyExpr view.relation}, definition := {stringLiteral view.definition}, checkOption := .{viewCheckOptionExpr view.checkOption}, securityBarrier := {boolExpr view.securityBarrier}, securityInvoker := {boolExpr view.securityInvoker}"

private def routineKeyExpr (key : Pgx.RoutineKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}, inputTypes := {arrayExpr (key.inputTypes.map typeRefExpr)}"

private def routineKindExpr : Pgx.RoutineKind → String
  | .function => "function"
  | .procedure => "procedure"
  | .aggregate => "aggregate"
  | .window => "window"

private def routineArgModeExpr : Pgx.RoutineArgMode → String
  | .input => "input"
  | .output => "output"
  | .inputOutput => "inputOutput"
  | .variadic => "variadic"
  | .table => "table"

private def routineArgExpr (arg : Pgx.RoutineArgIR) : String :=
  let name := optionExpr (arg.name.map stringLiteral)
  recordExpr s!"name := {name}, mode := .{routineArgModeExpr arg.mode}, ty := {typeRefExpr arg.ty}, hasDefault := {boolExpr arg.hasDefault}"

private def routineResultExpr (column : Pgx.RoutineResultColumnIR) : String :=
  recordExpr s!"name := {stringLiteral column.name}, ordinal := {column.ordinal}, ty := {typeRefExpr column.ty}, nullable := {boolExpr column.nullable}"

private def routineExpr (routine : Pgx.RoutineIR) : String :=
  let returnType := optionExpr (routine.returnType.map typeRefExpr)
  recordExpr s!"key := {routineKeyExpr routine.key}, kind := .{routineKindExpr routine.kind}, args := {arrayExpr (routine.args.map routineArgExpr)}, returnsSet := {boolExpr routine.returnsSet}, returnType := {returnType}, resultColumns := {arrayExpr (routine.resultColumns.map routineResultExpr)}, dynamicRecord := {boolExpr routine.dynamicRecord}, strict := {boolExpr routine.strict}, volatility := {stringLiteral routine.volatility}, parallel := {stringLiteral routine.parallel}, securityDefiner := {boolExpr routine.securityDefiner}"

private def extensionCodecPackageExpr (package : Pgx.ExtensionCodecPackageIR) : String :=
  recordExpr s!"extension := {stringLiteral package.extension}, version := {stringLiteral package.version}, importModule := {stringLiteral package.importModule}, types := {arrayExpr (package.types.map typeKeyExpr)}"

private def paramSpecExpr (param : Pgx.ParamIR) : String :=
  recordExpr s!"name := {stringLiteral param.name}, ty := {typeRefExpr param.ty}, nullable := {boolExpr param.nullable}"

private def columnSpecExpr (column : Pgx.QueryColumnIR) : String :=
  let origin := optionExpr (column.origin.map columnKeyExpr)
  recordExpr s!"name := {stringLiteral column.name}, ty := {typeRefExpr column.ty}, nullable := {boolExpr column.nullable}, origin := {origin}"

private def checkOverride (value : Pgx.TypeOverrideIR) : Except CodegenError Unit := do
  if value.leanType.trimAscii.toString.isEmpty then
    throw (.malformedIR s!"type override {value.key}" "Lean type declaration is empty")
  if value.codec.trimAscii.toString.isEmpty then
    throw (.malformedIR s!"type override {value.key}" "codec declaration is empty")
  match value.importModule with
  | none => pure ()
  | some moduleName =>
      if moduleName.isEmpty || moduleName.trimAscii.toString != moduleName then
        throw (.malformedIR s!"type override {value.key}"
          "import module is empty or contains surrounding whitespace")

private def checkTypeSupportedAux (db : Pgx.DatabaseIR) (key : Pgx.TypeKey)
    (context : String) (seen : Array Pgx.TypeKey) : Nat → Except CodegenError Unit
  | 0 => throw (.cyclicDomain key)
  | fuel + 1 => do
  if seen.contains key then throw (.cyclicDomain key)
  match db.typeOverride? key with
  | some value => checkOverride value
  | none =>
      match Pgx.builtinTypeMapping? key with
      | some _ => pure ()
      | none => do
          if (db.enum? key).isSome then
            pure ()
          else if let some domain := db.domain? key then
            checkTypeSupportedAux db domain.base.key context (seen.push key) fuel
          else if let some array := db.array? key then
            checkTypeSupportedAux db array.element.key context (seen.push key) fuel
          else if let some composite := db.composite? key then
            for field in composite.fields do
              checkTypeSupportedAux db field.ty.key context (seen.push key) fuel
          else if let some range := db.range? key then
            checkTypeSupportedAux db range.subtype.key context (seen.push key) fuel
          else if let some multirange := db.multirange? key then
            checkTypeSupportedAux db multirange.range context (seen.push key) fuel
          else
            throw (.unsupportedType key context)

private def checkTypeSupported (db : Pgx.DatabaseIR) (key : Pgx.TypeKey)
    (context : String) : Except CodegenError Unit :=
  checkTypeSupportedAux db key context #[]
    (db.domains.size + db.arrays.size + db.composites.size +
      db.ranges.size + db.multiranges.size + 1)

private def relation? (db : Pgx.DatabaseIR) (key : Pgx.RelationKey) :
    Option Pgx.RelationIR :=
  db.relations.find? (fun relation => relation.key == key)

private partial def wireBaseRefAux (db : Pgx.DatabaseIR) (ref : Pgx.TypeRef)
    (seen : Array Pgx.TypeKey) : Except CodegenError Pgx.TypeRef := do
  if seen.contains ref.key then throw (.cyclicDomain ref.key)
  match db.domain? ref.key with
  | none => pure ref
  | some domain => wireBaseRefAux db domain.base (seen.push ref.key)

private def wireBaseRef (db : Pgx.DatabaseIR) (ref : Pgx.TypeRef) :
    Except CodegenError Pgx.TypeRef :=
  wireBaseRefAux db ref #[]

/- `true` represents SQL NULL.  Domain expressions contain no column
bindings, but retaining both states for a defensive forged column keeps this
analysis conservative. -/
private def strictNullStates (left right : Array Bool) : Array Bool := Id.run do
  let mut states : Array Bool := #[]
  for l in left do
    for r in right do states := pushUnique states (l || r)
  return states

private partial def valueNullStates : Pgx.Constraint.ValueExpr → Array Bool
  | .column .. => #[false, true]
  | .domainValue .. => #[true]
  | .literal .null _ => #[true]
  | .literal _ _ => #[false]
  | .cast _ value _ | .neg value _ | .charLength value _ | .btrim value _ =>
      valueNullStates value
  | .add left right _ | .sub left right _ | .position left right _ =>
      strictNullStates (valueNullStates left) (valueNullStates right)

private partial def booleanLiteralAtNull? : Pgx.Constraint.ValueExpr → Option Bool
  | .literal (.boolean value) _ => some value
  | .cast _ value _ => booleanLiteralAtNull? value
  | _ => none

private def combineTruthStates (left right : Array Pgx.Constraint.SqlTruth)
    (combine : Pgx.Constraint.SqlTruth → Pgx.Constraint.SqlTruth →
      Pgx.Constraint.SqlTruth) : Array Pgx.Constraint.SqlTruth := Id.run do
  let mut states : Array Pgx.Constraint.SqlTruth := #[]
  for l in left do
    for r in right do states := pushUnique states (combine l r)
  return states

private partial def truthStatesAtNull : Pgx.Constraint.TruthExpr →
    Array Pgx.Constraint.SqlTruth
  | .constant none => #[.unknown]
  | .constant (some true) => #[.true]
  | .constant (some false) => #[.false]
  | .fromBoolean value =>
      match booleanLiteralAtNull? value with
      | some true => #[.true]
      | some false => #[.false]
      | none => Id.run do
        let mut states : Array Pgx.Constraint.SqlTruth := #[]
        for isNull in valueNullStates value do
          if isNull then states := pushUnique states .unknown
          else
            states := pushUnique (pushUnique states .true) .false
        return states
  | .compare _ left right => Id.run do
      let mut states : Array Pgx.Constraint.SqlTruth := #[]
      for l in valueNullStates left do
        for r in valueNullStates right do
          if l || r then states := pushUnique states .unknown
          else states := pushUnique (pushUnique states .true) .false
      return states
  | .isNull value =>
      valueNullStates value |>.map (fun isNull => if isNull then .true else .false)
  | .isNotNull value =>
      valueNullStates value |>.map (fun isNull => if isNull then .false else .true)
  | .and left right =>
      combineTruthStates (truthStatesAtNull left) (truthStatesAtNull right)
        Pgx.Constraint.SqlTruth.conjunction
  | .or left right =>
      combineTruthStates (truthStatesAtNull left) (truthStatesAtNull right)
        Pgx.Constraint.SqlTruth.disjunction
  | .not value => truthStatesAtNull value |>.map (fun truth => truth.negate)

private def constraintMayRejectNull (expression : Pgx.Constraint.TruthExpr) : Bool :=
  (truthStatesAtNull expression).contains .false

private partial def typeRejectsNullAux (db : Pgx.DatabaseIR) (key : Pgx.TypeKey)
    (seen : Array Pgx.TypeKey) : Bool :=
  if seen.contains key then false
  else
    match db.domain? key with
    | none => false
    | some domain =>
        domain.notNull ||
          domain.localConstraints.any (fun constraint =>
            constraintMayRejectNull constraint.expression) ||
          typeRejectsNullAux db domain.base.key (seen.push key)

private def typeRejectsNull (db : Pgx.DatabaseIR) (key : Pgx.TypeKey) : Bool :=
  typeRejectsNullAux db key #[]

private def validateScalarRefinementTypmod (db : Pgx.DatabaseIR) (ref : Pgx.TypeRef)
    (context : String) :
    Except CodegenError Unit := do
  if ref.typmod.isSome && (db.typeOverride? ref.key).isSome then
    throw (.unsupportedConstraint context
      s!"type override {ref.key} has no type-modifier refinement adapter")
  if ref.key.schema == "pg_catalog" &&
      (ref.key.name == "varchar" || ref.key.name == "bpchar") then
    match Pgx.Constraint.decodeCharacterTypmod ref.typmod with
    | .ok _ => pure ()
    | .error error => throw (.malformedIR context (toString error))
  else if ref.key.schema == "pg_catalog" && ref.key.name == "numeric" &&
      ref.typmod.isSome then
    match Pgx.Constraint.decodeNumericTypmod ref.typmod with
    | .ok _ => pure ()
    | .error error => throw (.malformedIR context (toString error))
  else if ref.key.schema == "pg_catalog" &&
      (ref.key.name == "time" || ref.key.name == "timestamp" ||
        ref.key.name == "timestamptz") && ref.typmod.isSome then
    match Pgx.Constraint.decodeTemporalPrecisionTypmod ref.typmod with
    | .ok _ => pure ()
    | .error error => throw (.malformedIR context (toString error))
  else if ref.key.schema == "pg_catalog" && ref.key.name == "interval" &&
      ref.typmod.isSome then
    match Pgx.Constraint.decodeIntervalPrecisionTypmod ref.typmod with
    | .ok _ => pure ()
    | .error error => throw (.malformedIR context (toString error))
  else
    pure ()

private def validateRefinementTypmod (db : Pgx.DatabaseIR) (ref : Pgx.TypeRef)
    (context : String) : Except CodegenError Unit := do
  if ref.key.kind == .array then
    if (db.typeOverride? ref.key).isSome then
      throw (.unsupportedConstraint context
        s!"type override {ref.key} has no type-modifier refinement adapter")
    let some array := db.array? ref.key
      | throw (.malformedIR context s!"array metadata for {ref.key} is absent")
    if array.element.key.kind == .array then
      throw (.unsupportedConstraint context
        "nested array element type modifiers are not supported")
    validateScalarRefinementTypmod db
      { array.element with typmod := ref.typmod } context
  else
    validateScalarRefinementTypmod db ref context

private def validateDomainConstraints (db : Pgx.DatabaseIR)
    (domain : Pgx.DomainIR) : Except CodegenError Unit := do
  if (db.typeOverride? domain.key).isSome &&
      (domain.notNull || !domain.localConstraints.isEmpty || domain.base.typmod.isSome) then
    throw (.unsupportedConstraint s!"domain {domain.key}"
      "a constrained type override requires an explicit refinement adapter")
  let raw := sortStrings domain.constraints
  let typed := sortStrings (domain.localConstraints.map (·.source))
  unless raw == typed do
    throw (.malformedIR s!"domain {domain.key}"
      "raw and typed local constraint definitions differ")
  for constraint in domain.localConstraints do
    match Pgx.Codegen.ConstraintParser.parseDomainCheck domain db.enums db.domains
        constraint.source with
    | .error diagnostic =>
        throw (.unsupportedConstraint s!"domain {domain.key} constraint {constraint.name}"
          (toString diagnostic))
    | .ok parsed =>
        unless parsed.validated == constraint.validated do
          throw (.malformedIR s!"domain {domain.key} constraint {constraint.name}"
            "NOT VALID suffix differs from catalog validation metadata")
        unless parsed.expression == constraint.expression do
          throw (.malformedIR s!"domain {domain.key} constraint {constraint.name}"
            "typed expression differs from reparsing its normalized source")

private def validateRelationConstraints (db : Pgx.DatabaseIR) :
    Except CodegenError Unit := do
  for constraint in db.constraints do
    let some relation := relation? db constraint.relation
      | throw (.malformedIR s!"constraint {constraint.name}"
          s!"relation {constraint.relation} is not present")
    if constraint.kind == .check then
      let some source := constraint.expression
        | throw (.malformedIR s!"constraint {constraint.name}"
            "check has no normalized source expression")
      let some expression := constraint.localExpression
        | throw (.malformedIR s!"constraint {constraint.name}"
            "check has no typed local expression")
      match Pgx.Codegen.ConstraintParser.parseTableCheck relation db.enums db.domains source with
      | .error diagnostic =>
          throw (.unsupportedConstraint s!"constraint {constraint.name}" (toString diagnostic))
      | .ok parsed =>
          unless parsed.validated == constraint.validated do
            throw (.malformedIR s!"constraint {constraint.name}"
              "NOT VALID suffix differs from catalog validation metadata")
          unless parsed.expression == expression do
            throw (.malformedIR s!"constraint {constraint.name}"
              "typed expression differs from reparsing its normalized source")
    else if constraint.localExpression.isSome then
      throw (.malformedIR s!"constraint {constraint.name}"
        "only a row-local check may carry a typed local expression")

private def validateLogicalColumn (db : Pgx.DatabaseIR) (queryName : String)
    (column : Pgx.QueryColumnIR) : Except CodegenError Unit := do
  let some logical := column.logicalType | pure ()
  let some _ := db.domain? logical.key
    | throw (.malformedIR s!"result {queryName}.{column.name}"
        "logicalType is not a declared domain")
  let some origin := column.origin
    | throw (.malformedIR s!"result {queryName}.{column.name}"
        "a logical domain requires direct column provenance")
  let some relation := relation? db origin.relation
    | throw (.malformedIR s!"result {queryName}.{column.name}"
        "logical origin relation is not present")
  let candidates := relation.columns.filter (fun source => source.name == origin.name)
  unless candidates.size == 1 && candidates[0]!.ty == logical do
    throw (.malformedIR s!"result {queryName}.{column.name}"
      "logical type differs from its source relation column")
  unless (← wireBaseRef db logical) == column.ty do
    throw (.malformedIR s!"result {queryName}.{column.name}"
      "wire type differs from the logical domain's fully unwrapped base")

private def validateIR (db : Pgx.DatabaseIR) : Except CodegenError Unit := do
  for value in db.enums do
    unless value.key.kind == .enum do
      throw (.malformedIR s!"enum {value.key}" "its TypeKey kind is not enum")
    if let some label := firstDuplicate? value.labels then
      throw (.malformedIR s!"enum {value.key}" s!"duplicate label {repr label}")
  for value in db.arrays do
    unless value.key.kind == .array do
      throw (.malformedIR s!"array {value.key}" "its TypeKey kind is not array")
    unless value.delimiter == "," do
      throw (.unsupportedType value.key
        s!"array {value.key} uses delimiter {repr value.delimiter}; only comma is supported")
    checkTypeSupported db value.element.key s!"array element {value.key}"
    let base ← wireBaseRef db value.element
    validateRefinementTypmod db base s!"array element {value.key}"
  for value in db.domains do
    unless value.key.kind == .domain do
      throw (.malformedIR s!"domain {value.key}" "its TypeKey kind is not domain")
    validateRefinementTypmod db value.base s!"domain {value.key}"
    validateDomainConstraints db value
  for value in db.composites do
    unless value.key.kind == .composite do
      throw (.malformedIR s!"composite {value.key}"
        "its TypeKey kind is not composite")
    if let some name := firstDuplicate? (value.fields.map (·.name)) then
      throw (.malformedIR s!"composite {value.key}" s!"duplicate field {repr name}")
    for i in [0:value.fields.size] do
      let field := value.fields[i]!
      unless field.ordinal == i + 1 do
        throw (.malformedIR s!"composite {value.key}"
          "field ordinals must be dense and start at one")
      checkTypeSupported db field.ty.key s!"composite field {value.key}.{field.name}"
      let base ← wireBaseRef db field.ty
      validateRefinementTypmod db base s!"composite field {value.key}.{field.name}"
  for value in db.ranges do
    unless value.key.kind == .range do
      throw (.malformedIR s!"range {value.key}" "its TypeKey kind is not range")
    unless value.multirange.kind == .multirange do
      throw (.malformedIR s!"range {value.key}" "its linked type is not a multirange")
    let some linked := db.multirange? value.multirange
      | throw (.malformedIR s!"range {value.key}"
          s!"linked multirange {value.multirange} is absent")
    unless linked.range == value.key do
      throw (.malformedIR s!"range {value.key}"
        s!"linked multirange {value.multirange} points to {linked.range}")
    checkTypeSupported db value.subtype.key s!"range subtype {value.key}"
    let base ← wireBaseRef db value.subtype
    validateRefinementTypmod db base s!"range subtype {value.key}"
  for value in db.multiranges do
    unless value.key.kind == .multirange do
      throw (.malformedIR s!"multirange {value.key}"
        "its TypeKey kind is not multirange")
    unless value.range.kind == .range do
      throw (.malformedIR s!"multirange {value.key}" "its linked type is not a range")
    let some linked := db.range? value.range
      | throw (.malformedIR s!"multirange {value.key}"
          s!"linked range {value.range} is absent")
    unless linked.multirange == value.key do
      throw (.malformedIR s!"multirange {value.key}"
        s!"linked range {value.range} points to {linked.multirange}")
  let declaredTypeKeys := db.enums.map (·.key) ++ db.arrays.map (·.key) ++
    db.domains.map (·.key) ++ db.composites.map (·.key) ++
    db.ranges.map (·.key) ++ db.multiranges.map (·.key)
  if let some key := firstDuplicate? declaredTypeKeys then throw (.duplicateType key)
  if let some key := firstDuplicate? (db.typeOverrides.map (·.key)) then throw (.duplicateType key)
  for value in db.typeOverrides do checkOverride value
  if let some extension := firstDuplicate? (db.extensionCodecPackages.map (·.extension)) then
    throw (.malformedIR s!"extension codec package {extension}"
      "duplicate package provenance")
  let mut packagedTypes : Array Pgx.TypeKey := #[]
  for package in db.extensionCodecPackages do
    if package.extension.trimAscii.toString.isEmpty ||
        package.extension.trimAscii.toString != package.extension then
      throw (.malformedIR "extension codec package"
        "extension name is empty or contains surrounding whitespace")
    if package.version.trimAscii.toString.isEmpty ||
        package.importModule.trimAscii.toString.isEmpty then
      throw (.malformedIR s!"extension codec package {package.extension}"
        "installed version and import module must be nonempty")
    let some requiredVersion := db.requiredExtensions.find? (fun value =>
        value.1 == package.extension) |>.map (·.2)
      | throw (.malformedIR s!"extension codec package {package.extension}"
          "extension is not present in requiredExtensions")
    unless requiredVersion == package.version do
      throw (.malformedIR s!"extension codec package {package.extension}"
        "installed version differs from requiredExtensions")
    if package.types.isEmpty then
      throw (.malformedIR s!"extension codec package {package.extension}"
        "package contains no types")
    if let some key := firstDuplicate? package.types then
      throw (.malformedIR s!"extension codec package {package.extension}"
        s!"duplicate type {key}")
    for key in package.types do
      if packagedTypes.contains key then
        throw (.malformedIR s!"extension codec package {package.extension}"
          s!"type {key} belongs to more than one package")
      packagedTypes := packagedTypes.push key
      let some override := db.typeOverride? key
        | throw (.malformedIR s!"extension codec package {package.extension}"
            s!"type {key} has no resolved override")
      unless override.importModule == some package.importModule do
        throw (.malformedIR s!"extension codec package {package.extension}"
          s!"type {key} is not owned by import {package.importModule}")

  if let some key := firstDuplicate? (db.relations.map (·.key)) then
    throw (.duplicateRelation key)
  for relation in db.relations do
    if let some name := firstDuplicate? (relation.columns.map (·.name)) then
      throw (.malformedIR s!"relation {relation.key}" s!"duplicate column {repr name}")
    for column in relation.columns do
      checkTypeSupported db column.ty.key s!"column {relation.key}.{column.name}"
      let base ← wireBaseRef db column.ty
      validateRefinementTypmod db base s!"column {relation.key}.{column.name}"

  if let some key := firstDuplicate? (db.views.map (·.relation)) then
    throw (.malformedIR s!"view {key}" "duplicate semantic view metadata")
  for view in db.views do
    let some relation := relation? db view.relation
      | throw (.malformedIR s!"view {view.relation}" "relation metadata is absent")
    unless relation.kind == .view || relation.kind == .materializedView do
      throw (.malformedIR s!"view {view.relation}"
        "semantic view metadata refers to a non-view relation")
    if view.definition.trimAscii.toString.isEmpty then
      throw (.malformedIR s!"view {view.relation}" "definition is empty")
    if relation.kind == .materializedView then
      unless view.checkOption == .none && !view.securityBarrier && !view.securityInvoker do
        throw (.malformedIR s!"view {view.relation}"
          "materialized views cannot carry ordinary view options")

  if let some key := firstDuplicate? (db.routines.map (·.key)) then
    throw (.malformedIR s!"routine {key}" "duplicate overload identity")
  for routine in db.routines do
    let inputTypes := routine.args.filter (fun arg => arg.mode.isInput) |>.map (·.ty)
    unless routine.key.inputTypes == inputTypes do
      throw (.malformedIR s!"routine {routine.key}"
        "overload input vector differs from the declared input arguments")
    if routine.volatility != "i" && routine.volatility != "s" && routine.volatility != "v" then
      throw (.malformedIR s!"routine {routine.key}" "unknown volatility code")
    if routine.parallel != "s" && routine.parallel != "r" && routine.parallel != "u" then
      throw (.malformedIR s!"routine {routine.key}" "unknown parallel-safety code")
    for i in [0:routine.resultColumns.size] do
      let column := routine.resultColumns[i]!
      unless column.ordinal == i + 1 do
        throw (.malformedIR s!"routine {routine.key}"
          "result ordinals must be dense and start at one")

  validateRelationConstraints db

  if let some name := firstDuplicate? (db.queries.map (·.name)) then
    throw (.duplicateQuery name)
  for query in db.queries do
    if query.name.trimAscii.toString.isEmpty then
      throw (.malformedIR "query" "generated Lean name is empty")
    if let some name := firstDuplicate? (query.params.map (·.name)) then
      throw (.malformedIR s!"query {query.name}" s!"duplicate parameter name {repr name}")
    if let some name := firstDuplicate? (query.columns.map (·.name)) then
      throw (.malformedIR s!"query {query.name}" s!"duplicate result name {repr name}")
    for i in [0:query.params.size] do
      unless query.params[i]!.position == i + 1 do
        throw (.malformedIR s!"query {query.name}"
          "parameter positions must be dense and start at one")
    if query.cardinality == .execute && !query.columns.isEmpty then
      throw (.malformedIR s!"query {query.name}"
        "execute cardinality cannot have result columns")
    if query.cardinality != .execute && query.columns.isEmpty then
      throw (.malformedIR s!"query {query.name}"
        "row-returning cardinality must have at least one result column")
    if let some relation := firstDuplicate? query.rowPreservedRelations then
      throw (.malformedIR s!"query {query.name}"
        s!"duplicate row-preserved relation {relation}")
    for key in query.rowPreservedRelations do
      unless (relation? db key).isSome do
        throw (.malformedIR s!"query {query.name}"
          s!"row-preserved relation {key} is not present")
      unless query.columns.any (fun column =>
          column.origin.map (fun origin => origin.relation == key) |>.getD false) do
        throw (.malformedIR s!"query {query.name}"
          s!"row-preserved relation {key} has no direct result column")
      if query.columns.any (fun column =>
          column.nullWidened &&
            (column.origin.map (fun origin => origin.relation == key) |>.getD false)) then
        throw (.malformedIR s!"query {query.name}"
          s!"row-preserved relation {key} has a null-widened result")
    for param in query.params do
      checkTypeSupported db param.ty.key s!"parameter {query.name}.${param.position}"
    for column in query.columns do
      if column.name.isEmpty then
        throw (.malformedIR s!"query {query.name}" "result column name is empty")
      if column.nullWidened && !column.nullable then
        throw (.malformedIR s!"result {query.name}.{column.name}"
          "a null-widened result must be nullable")
      checkTypeSupported db column.ty.key s!"result {query.name}.{column.name}"
      if let some logical := column.logicalType then
        checkTypeSupported db logical.key s!"logical result {query.name}.{column.name}"
      validateLogicalColumn db query.name column
      let base ← wireBaseRef db (column.logicalType.getD column.ty)
      validateRefinementTypmod db base s!"result {query.name}.{column.name}"
    let planned := Pgx.Codegen.Projection.planQuery db.relations db.constraints query
    unless planned.localConstraints == query.localConstraints do
      throw (.malformedIR s!"query {query.name}"
        "local constraints differ from the direct-projection plan")

  for value in db.enums do checkTypeSupported db value.key s!"enum {value.key}"
  for value in db.arrays do checkTypeSupported db value.key s!"array {value.key}"
  for value in db.domains do
    checkTypeSupported db value.key s!"domain {value.key}"
  for value in db.composites do checkTypeSupported db value.key s!"composite {value.key}"
  for value in db.ranges do checkTypeSupported db value.key s!"range {value.key}"
  for value in db.multiranges do checkTypeSupported db value.key s!"multirange {value.key}"

private def namedType? (plan : NamingPlan) (key : Pgx.TypeKey) : Option NamedType :=
  plan.types.find? (fun value => value.key == key)

private def resolveTypeUse (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (key : Pgx.TypeKey) : Except CodegenError TypeUse := do
  match db.typeOverride? key with
  | some value => pure { leanType := value.leanType, codec := some value.codec }
  | none =>
      match Pgx.builtinTypeMapping? key with
      | some value => pure { leanType := value.leanType }
      | none =>
          match namedType? plan key with
          | some value => pure { leanType := value.leanType, codec := some value.codec }
          | none => throw (.unsupportedType key "generated type lookup")

private def fieldType (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (ref : Pgx.TypeRef) (nullable : Bool) : Except CodegenError String := do
  let value ← resolveTypeUse plan db ref.key
  if nullable then pure s!"Option ({value.leanType})" else pure value.leanType

private def buildTypeNames (modulePrefix : String) (db : Pgx.DatabaseIR) : Array NamedType := Id.run do
  let mut scope : Scope := {}
  let mut values : Array NamedType := #[]
  for value in db.enums do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  for value in db.domains do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  for value in db.composites do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  for value in db.ranges do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  for value in db.multiranges do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  -- Preserve the public names of semantic types when PostgreSQL's
  -- automatically named array type normalizes to the same Lean identifier.
  for value in db.arrays do
    if (db.typeOverride? value.key).isNone then
      let preferred := upperCamel value.key.schema ++ upperCamel value.key.name
      let (name, next) := scope.claim preferred
      scope := next
      let leanType := modulePrefix ++ ".Types." ++ name
      values := values.push { key := value.key, leanType, codec := leanType ++ ".codec" }
  return values

private def buildSchemas (db : Pgx.DatabaseIR) : Array NamedSchema := Id.run do
  let mut sourceNames : Array String := #[]
  for schema in db.schemas do sourceNames := pushUnique sourceNames schema.name
  for relation in db.relations do sourceNames := pushUnique sourceNames relation.key.schema
  sourceNames := sortStrings sourceNames
  let mut scope : Scope := {}
  let mut values : Array NamedSchema := #[]
  for source in sourceNames do
    let (leanName, next) := scope.claim (upperCamel source "Schema")
    scope := next
    values := values.push { source, leanName }
  return values

private def buildRelations (schemas : Array NamedSchema)
    (db : Pgx.DatabaseIR) : Array NamedRelation := Id.run do
  let mut values : Array NamedRelation := #[]
  for relation in db.relations do
    let schemaName := (schemas.find? (fun value => value.source == relation.key.schema)).map
      (·.leanName) |>.getD (upperCamel relation.key.schema "Schema")
    let used := values.filter (fun value => value.key.schema == relation.key.schema)
      |>.map (·.relationName)
    let scope : Scope := { used }
    let (relationName, _) := scope.claim (upperCamel relation.key.name "Relation")
    values := values.push { key := relation.key, schemaName, relationName }
  return values

private def buildQueries (db : Pgx.DatabaseIR) : Array NamedQuery := Id.run do
  let mut scope : Scope := {}
  let mut values : Array NamedQuery := #[]
  for query in db.queries do
    let (moduleName, next) := scope.claim (upperCamel query.name "Query")
    scope := next
    values := values.push { query, moduleName }
  return values

private def buildNamingPlan (modulePrefix : String)
    (db : Pgx.DatabaseIR) : Except CodegenError NamingPlan := do
  let (normalizedPrefix, prefixPath) ← normalizePrefix modulePrefix
  let types := buildTypeNames normalizedPrefix db
  let schemas := buildSchemas db
  pure {
    modulePrefix := normalizedPrefix
    prefixPath
    types
    schemas
    relations := buildRelations schemas db
    queries := buildQueries db
  }

private def domainDependencyPending (db : Pgx.DatabaseIR)
    (pending : Array Pgx.DomainIR) (domain : Pgx.DomainIR) : Bool :=
  (db.typeOverride? domain.base.key).isNone &&
    pending.any (fun candidate => candidate.key == domain.base.key)

private def orderDomainsAux (db : Pgx.DatabaseIR) (pending ready : Array Pgx.DomainIR) :
    Nat → Except CodegenError (Array Pgx.DomainIR)
  | 0 =>
      match pending[0]? with
      | some value => throw (.cyclicDomain value.key)
      | none => pure ready
  | fuel + 1 =>
      if pending.isEmpty then pure ready
      else
        let layer := pending.filter (fun value => !domainDependencyPending db pending value)
        if layer.isEmpty then
          throw (.cyclicDomain pending[0]!.key)
        else
          let rest := pending.filter (fun value => !layer.any (fun done => done.key == value.key))
          orderDomainsAux db rest (ready ++ layer) fuel

private def orderedGeneratedDomains (db : Pgx.DatabaseIR) :
    Except CodegenError (Array Pgx.DomainIR) :=
  let pending := db.domains.filter (fun value => (db.typeOverride? value.key).isNone)
  orderDomainsAux db pending #[] (pending.size + 1)

private def generatedTypeDependencies (db : Pgx.DatabaseIR)
    (key : Pgx.TypeKey) : Array Pgx.TypeKey :=
  match db.domain? key with
  | some value => #[value.base.key]
  | none =>
      match db.array? key with
      | some value => #[value.element.key]
      | none =>
          match db.composite? key with
          | some value => value.fields.map (·.ty.key)
          | none =>
              match db.range? key with
              | some value => #[value.subtype.key]
              | none =>
                  match db.multirange? key with
                  | some value =>
                      match db.range? value.range with
                      | some range => #[range.subtype.key]
                      | none => #[value.range]
                  | none => #[]

private def generatedNonEnumTypeKeys (db : Pgx.DatabaseIR) : Array Pgx.TypeKey :=
  (db.arrays.map (·.key) ++ db.domains.map (·.key) ++
    db.composites.map (·.key) ++ db.ranges.map (·.key) ++
    db.multiranges.map (·.key)).filter fun key => (db.typeOverride? key).isNone

private def generatedDependencyPending (db : Pgx.DatabaseIR)
    (pending : Array Pgx.TypeKey) (key : Pgx.TypeKey) : Bool :=
  (generatedTypeDependencies db key).any fun dependency =>
    (db.typeOverride? dependency).isNone && pending.contains dependency

private def orderGeneratedTypesAux (db : Pgx.DatabaseIR)
    (pending ready : Array Pgx.TypeKey) : Nat → Except CodegenError (Array Pgx.TypeKey)
  | 0 =>
      match pending[0]? with
      | some key => throw (.cyclicType key)
      | none => pure ready
  | fuel + 1 =>
      if pending.isEmpty then pure ready
      else
        let layer := pending.filter fun key => !generatedDependencyPending db pending key
        if layer.isEmpty then
          throw (.cyclicType pending[0]!)
        else
          let rest := pending.filter fun key => !layer.contains key
          orderGeneratedTypesAux db rest (ready ++ layer) fuel

private def orderedGeneratedTypes (db : Pgx.DatabaseIR) :
    Except CodegenError (Array Pgx.TypeKey) :=
  let pending := generatedNonEnumTypeKeys db
  orderGeneratedTypesAux db pending #[] (pending.size + 1)

private def collectTypeKeys (db : Pgx.DatabaseIR) : Array Pgx.TypeKey := Id.run do
  let mut values : Array Pgx.TypeKey := #[]
  for value in db.enums do values := pushUnique values value.key
  for value in db.arrays do
    values := pushUnique values value.key
    values := pushUnique values value.element.key
  for value in db.domains do
    values := pushUnique values value.key
    values := pushUnique values value.base.key
  for value in db.composites do
    values := pushUnique values value.key
    for field in value.fields do values := pushUnique values field.ty.key
  for value in db.ranges do
    values := pushUnique values value.key
    values := pushUnique values value.subtype.key
    values := pushUnique values value.multirange
  for value in db.multiranges do
    values := pushUnique values value.key
    values := pushUnique values value.range
  for value in db.typeOverrides do values := pushUnique values value.key
  for relation in db.relations do
    for column in relation.columns do values := pushUnique values column.ty.key
  for query in db.queries do
    for param in query.params do values := pushUnique values param.ty.key
    for column in query.columns do
      values := pushUnique values column.ty.key
      if let some logical := column.logicalType then values := pushUnique values logical.key
  for routine in db.routines do
    for arg in routine.args do values := pushUnique values arg.ty.key
    if let some result := routine.returnType then values := pushUnique values result.key
    for column in routine.resultColumns do values := pushUnique values column.ty.key
  return sortTypeKeys values

private def allocatedNames (sources : Array String) (fallback : String) : Array String := Id.run do
  let mut scope : Scope := { used := #["mk"] }
  let mut names : Array String := #[]
  for source in sources do
    let (name, next) := scope.claim (lowerCamel source fallback)
    scope := next
    names := names.push name
  return names

private structure ExprBinding where
  sourceName : String
  access : String
  declared : Pgx.TypeRef
  storage : Pgx.TypeRef
  nullable : Bool
  deriving Inhabited

private structure ExprScope where
  columns : Array ExprBinding := #[]
  domainValue : Option ExprBinding := none

private structure CompiledValue where
  expression : String
  semanticType : String
  scalarType : Pgx.Constraint.ScalarType

private structure GeneratedCheck where
  name : String
  evaluate : String

private def semanticTypeName (context : String) : Pgx.Constraint.ScalarType →
    Except CodegenError String
  | { base := .boolean, .. } => pure "Bool"
  | { base := .int16, .. } | { base := .int32, .. } | { base := .int64, .. } =>
      pure "Int"
  | { base := .text, .. } | { base := .enumeration _, .. } => pure "String"
  | { base := .numeric, .. } =>
      throw (.unsupportedConstraint context
        "pg_catalog.numeric has no modeled exact local comparison semantics")

private partial def scalarizeStorageAux (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (ref : Pgx.TypeRef) (expression context : String) (seen : Array Pgx.TypeKey) :
    Except CodegenError String := do
  if seen.contains ref.key then throw (.cyclicDomain ref.key)
  if (db.typeOverride? ref.key).isSome then
    throw (.unsupportedConstraint context
      s!"type override {ref.key} has no local-refinement scalar adapter")
  match db.domain? ref.key with
  | some domain =>
      let some named := namedType? plan ref.key
        | throw (.unsupportedConstraint context
            s!"domain {ref.key} has no generated local validator")
      scalarizeStorageAux plan db domain.base
        s!"{named.leanType}.toBase ({expression})" context (seen.push ref.key)
  | none =>
      match db.enum? ref.key with
      | some _ =>
          let some named := namedType? plan ref.key
            | throw (.unsupportedConstraint context
                s!"enum {ref.key} has no generated label mapping")
          pure s!"{named.leanType}.toLabel ({expression})"
      | none =>
          if ref.key.schema != "pg_catalog" then
            throw (.unsupportedConstraint context
              s!"type {ref.key} has no local-refinement scalar adapter")
          else if ref.key.name == "bool" then pure expression
          else if ref.key.name == "int2" || ref.key.name == "int4" ||
              ref.key.name == "int8" then
            pure s!"({expression}).toInt"
          else if ref.key.name == "text" || ref.key.name == "varchar" ||
              ref.key.name == "bpchar" || ref.key.name == "name" ||
              ref.key.name == "char" then
            pure expression
          else
            throw (.unsupportedConstraint context
              s!"type {ref.key} has no local-refinement scalar adapter")

private def scalarizeStorage (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (ref : Pgx.TypeRef) (expression context : String) : Except CodegenError String :=
  scalarizeStorageAux plan db ref expression context #[]

private def findBinding (scope : ExprScope) (name context : String) :
    Except CodegenError ExprBinding := do
  let bindings := scope.columns.filter (fun binding => binding.sourceName == name)
  unless bindings.size == 1 do
    throw (.malformedIR context s!"column {repr name} does not resolve uniquely")
  pure bindings[0]!

private def optionValueExpression (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (binding : ExprBinding) (semanticType context : String) : Except CodegenError String := do
  let payload ← scalarizeStorage plan db binding.storage "present" context
  if binding.nullable then
    pure s!"({binding.access}).map (fun present => {payload})"
  else
    pure s!"(some ({← scalarizeStorage plan db binding.storage binding.access context}) : Option {semanticType})"

private partial def compileValueExpr (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (scope : ExprScope) (context : String) : Pgx.Constraint.ValueExpr →
    Except CodegenError CompiledValue
  | expression@(.column name ty nullable) => do
      let binding ← findBinding scope name context
      unless binding.declared == ty.declared && binding.nullable == nullable do
        throw (.malformedIR context s!"column annotation for {repr name} differs from its field")
      let semanticType ← semanticTypeName context ty
      let payload ← optionValueExpression plan db binding semanticType context
      pure {
        expression := s!"(.ok ({payload}) : Except Pgx.Constraint.EvaluationError (Option {semanticType}))"
        semanticType
        scalarType := expression.type
      }
  | expression@(.domainValue ty _) => do
      let some binding := scope.domainValue
        | throw (.malformedIR context "VALUE appears outside a domain constraint")
      unless binding.declared == ty.declared do
        throw (.malformedIR context "VALUE annotation differs from its domain")
      let semanticType ← semanticTypeName context ty
      let payload ← optionValueExpression plan db binding semanticType context
      pure {
        expression := s!"(.ok ({payload}) : Except Pgx.Constraint.EvaluationError (Option {semanticType}))"
        semanticType
        scalarType := expression.type
      }
  | expression@(.literal literal ty) => do
      let semanticType ← semanticTypeName context ty
      let payload ← match literal with
        | .null => pure s!"(none : Option {semanticType})"
        | .boolean value => pure s!"some ({boolExpr value})"
        | .integer value => pure s!"some ({value})"
        | .numeric _ =>
            throw (.unsupportedConstraint context
              "pg_catalog.numeric literals have no modeled exact local semantics")
        | .text value => pure s!"some ({stringLiteral value})"
        | .enumeration _ label => pure s!"some ({stringLiteral label})"
      pure {
        expression := s!"(.ok ({payload}) : Except Pgx.Constraint.EvaluationError (Option {semanticType}))"
        semanticType
        scalarType := expression.type
      }
  | expression@(.cast preservation value target) => do
      if preservation == .exactNumeric then
        throw (.unsupportedConstraint context
          "exact numeric casts have no modeled local semantics")
      let compiled ← compileValueExpr plan db scope context value
      let targetType ← semanticTypeName context target
      unless compiled.semanticType == targetType do
        throw (.malformedIR context "preserving cast changes its normalized semantic carrier")
      pure { compiled with scalarType := expression.type }
  | .neg .. =>
      throw (.unsupportedConstraint context
        "fixed-width unary negation requires modeled PostgreSQL overflow semantics")
  | .add .. | .sub .. =>
      throw (.unsupportedConstraint context
        "fixed-width arithmetic requires modeled PostgreSQL overflow semantics")
  | expression@(.charLength value _) => do
      let compiled ← compileValueExpr plan db scope context value
      unless compiled.semanticType == "String" do
        throw (.malformedIR context "char_length operand is not text")
      pure {
        expression := s!"({compiled.expression}).bind (fun value => Pgx.Constraint.liftNullable (fun present => .ok (Pgx.Constraint.charLength present)) value)"
        semanticType := "Int"
        scalarType := expression.type
      }
  | expression@(.btrim value _) => do
      let compiled ← compileValueExpr plan db scope context value
      unless compiled.semanticType == "String" do
        throw (.malformedIR context "btrim operand is not text")
      pure {
        expression := s!"({compiled.expression}).bind (fun value => Pgx.Constraint.liftNullable (fun present => .ok (Pgx.Constraint.btrim present)) value)"
        semanticType := "String"
        scalarType := expression.type
      }
  | expression@(.position substring string _) => do
      let left ← compileValueExpr plan db scope context substring
      let right ← compileValueExpr plan db scope context string
      unless left.semanticType == "String" && right.semanticType == "String" do
        throw (.malformedIR context "position operands are not text")
      pure {
        expression := s!"({left.expression}).bind (fun substring => ({right.expression}).bind (fun string => Pgx.Constraint.liftNullable₂ (fun needle haystack => .ok (Pgx.Constraint.position needle haystack)) substring string))"
        semanticType := "Int"
        scalarType := expression.type
      }

private def comparisonName : Pgx.Constraint.Comparison → String
  | .eq => "eq"
  | .ne => "ne"
  | .lt => "lt"
  | .le => "le"
  | .gt => "gt"
  | .ge => "ge"

private partial def compileTruthExpr (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (scope : ExprScope) (context : String) : Pgx.Constraint.TruthExpr →
    Except CodegenError String
  | .constant none => pure "(.ok .unknown)"
  | .constant (some true) => pure "(.ok .true)"
  | .constant (some false) => pure "(.ok .false)"
  | .fromBoolean value => do
      let compiled ← compileValueExpr plan db scope context value
      unless compiled.semanticType == "Bool" do
        throw (.malformedIR context "Boolean truth expression has a non-Boolean carrier")
      pure s!"({compiled.expression}).map Pgx.Constraint.SqlTruth.ofOptionBool"
  | .compare operator left right => do
      let left ← compileValueExpr plan db scope context left
      let right ← compileValueExpr plan db scope context right
      unless left.semanticType == right.semanticType do
        throw (.malformedIR context "comparison operands use different semantic carriers")
      let body ← match operator with
        | .eq => pure "Pgx.Constraint.equalNullable left right"
        | .ne => pure "Pgx.Constraint.notEqualNullable left right"
        | operator =>
            unless left.semanticType == "Int" do
              throw (.unsupportedConstraint context
                "only fixed-width integer ordering has modeled local semantics")
            pure s!"Pgx.Constraint.compareNullable .{comparisonName operator} left right"
      pure s!"({left.expression}).bind (fun left => ({right.expression}).map (fun right => {body}))"
  | .isNull value => do
      let compiled ← compileValueExpr plan db scope context value
      pure s!"({compiled.expression}).map Pgx.Constraint.SqlTruth.isNull"
  | .isNotNull value => do
      let compiled ← compileValueExpr plan db scope context value
      pure s!"({compiled.expression}).map Pgx.Constraint.SqlTruth.isNotNull"
  | .and left right => do
      let left ← compileTruthExpr plan db scope context left
      let right ← compileTruthExpr plan db scope context right
      pure s!"({left}).bind (fun left => ({right}).map (fun right => left.conjunction right))"
  | .or left right => do
      let left ← compileTruthExpr plan db scope context left
      let right ← compileTruthExpr plan db scope context right
      pure s!"({left}).bind (fun left => ({right}).map (fun right => left.disjunction right))"
  | .not value => do
      let value ← compileTruthExpr plan db scope context value
      pure s!"({value}).map Pgx.Constraint.SqlTruth.negate"

private def scalarTypmodCheck? (ref : Pgx.TypeRef) (access : String)
    (nullable : Bool) (name : String) : Option GeneratedCheck :=
  let optionalValue := if nullable then access else s!"some ({access})"
  if ref.typmod.isSome && ref.key.schema == "pg_catalog" &&
      (ref.key.name == "varchar" || ref.key.name == "bpchar") && ref.typmod.isSome then
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluateCharacterTypmod ({optionExpr (ref.typmod.map toString)}) ({optionalValue})"
    }
  else if ref.typmod.isSome && ref.key.schema == "pg_catalog" &&
      ref.key.name == "numeric" then
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluateNumericTypmod ({optionExpr (ref.typmod.map toString)}) ({optionalValue})"
    }
  else if ref.key.schema == "pg_catalog" && ref.key.name == "time" then
    let nanos := if nullable then
      s!"({access}).map (fun item => item.toNanoseconds.toInt)"
    else s!"some (({access}).toNanoseconds.toInt)"
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluateTimeTypmod ({optionExpr (ref.typmod.map toString)}) ({nanos})"
    }
  else if ref.key.schema == "pg_catalog" &&
      ref.key.name == "timestamp" then
    let nanos := if nullable then
      s!"({access}).map (fun item => item.time.toNanoseconds.toInt)"
    else s!"some (({access}).time.toNanoseconds.toInt)"
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluateTimestampTypmod ({optionExpr (ref.typmod.map toString)}) ({nanos})"
    }
  else if ref.key.schema == "pg_catalog" &&
      ref.key.name == "timestamptz" then
    let nanos := if nullable then
      s!"({access}).map (fun item => item.toNanosecondsSinceUnixEpoch.toInt)"
    else s!"some (({access}).toNanosecondsSinceUnixEpoch.toInt)"
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluateTimestamptzTypmod ({optionExpr (ref.typmod.map toString)}) ({nanos})"
    }
  else if ref.typmod.isSome && ref.key.schema == "pg_catalog" &&
      ref.key.name == "interval" then
    some {
      name
      evaluate := s!"Pgx.Constraint.evaluatePgIntervalPrecisionTypmod ({optionExpr (ref.typmod.map toString)}) ({optionalValue})"
    }
  else none

private def typmodCheck? (db : Pgx.DatabaseIR) (ref : Pgx.TypeRef)
    (access : String) (nullable : Bool) (name : String) : Option GeneratedCheck :=
  let optionalValue := if nullable then access else s!"some ({access})"
  if ref.key.kind == .array then
    match db.array? ref.key with
    | none => none
    | some array =>
      let elementRef := { array.element with typmod := ref.typmod }
      match scalarTypmodCheck? elementRef "item" true name with
      | none => none
      | some elementCheck => some {
          name
          evaluate := s!"Pgx.Constraint.evaluateArrayElements (fun item => {elementCheck.evaluate}) ({optionalValue})"
        }
  else
    scalarTypmodCheck? ref access nullable name

private def emitValidator (dataType publicType : String)
    (checks : Array GeneratedCheck) : List String :=
  let checkExprs := checks.map fun check =>
    recordExpr s!"name := {stringLiteral check.name}, evaluate := fun value => {check.evaluate}"
  [
    s!"private def checks : List (Pgx.Constraint.Check {dataType}) :=",
    "  [" ++ commaSep checkExprs ++ "]",
    "",
    s!"def ValidPred (value : {dataType}) : Prop :=",
    "  Pgx.Constraint.Valid checks value",
    "",
    s!"instance (value : {dataType}) : Decidable (ValidPred value) :=",
    "  Pgx.Constraint.validDecidable checks value",
    "",
    "abbrev " ++ publicType ++ " := { value : " ++ dataType ++ " // ValidPred value }",
    "",
    s!"def validate (value : {dataType}) : Except Pgx.ConstraintViolation {publicType} :=",
    "  Pgx.Constraint.validate checks value",
    "",
    "theorem validate_sound {value : " ++ dataType ++ "} {refined : " ++ publicType ++ "} :",
    "    validate value = .ok refined → refined.val = value ∧ ValidPred value := by",
    "  exact Pgx.Constraint.validate_sound checks",
    "",
    "theorem validate_complete {value : " ++ dataType ++ "} :",
    s!"    ValidPred value → ∃ refined : {publicType}, validate value = .ok refined := by",
    "  exact Pgx.Constraint.validate_complete checks",
    ""
  ]

private def rawEncodeBody (use : TypeUse) : List String :=
  match use.codec with
  | some codec => [s!"  {codec}.encode resolve resolved value"]
  | none => [
      "  let _ := resolved",
      "  pure {",
      s!"    format := Pg.PgEncode.format {use.leanType}",
      "    value := Pg.PgEncode.encode value",
      "  }"
    ]

private def rawDecodeBody (use : TypeUse) : List String :=
  match use.codec with
  | some codec => [s!"  {codec}.decode resolve resolved format value"]
  | none => [
      s!"  match Pg.decodeValue (α := {use.leanType}) resolved.oid format value with",
      "  | .ok decoded => pure decoded",
      "  | .error message => throw (.decode message)"
    ]

private def componentEncodeBody (ref : Pgx.TypeRef) (use : TypeUse) : List String :=
  match use.codec with
  | some codec =>
      [s!"  {codec}.encodeText resolve ({typeRefExpr ref}) value"]
  | none =>
      if ref.key.schema == "pg_catalog" && ref.key.name == "bytea" then
        ["  let _ := resolve",
          s!"  pure ({stringLiteral "\\x"} ++ Pg.Crypto.toHexLower value)"]
      else
        ["  let _ := resolve", "  Pgx.Typed.encodeBuiltinText value"]

private def componentDecodeTextBody (ref : Pgx.TypeRef) (use : TypeUse) : List String :=
  match use.codec with
  | some codec =>
      [s!"  {codec}.decodeText resolve ({typeRefExpr ref}) value"]
  | none => [
      s!"  let resolved ← resolve ({typeKeyExpr ref.key})",
      s!"  Pgx.Typed.decodeBuiltinText (α := {use.leanType}) resolved value"
    ]

private def componentDecodeBinaryBody (ref : Pgx.TypeRef) (use : TypeUse) : List String :=
  match use.codec with
  | some codec =>
      [s!"  {codec}.decodeBinary resolve ({typeRefExpr ref}) oid value"]
  | none => [
      s!"  let resolved ← resolve ({typeKeyExpr ref.key})",
      s!"  Pgx.Typed.decodeBuiltinBinary (α := {use.leanType}) resolved oid value"
    ]

private def emitComponentHelpers (stem : String) (ref : Pgx.TypeRef)
    (use : TypeUse) : List String :=
  [
    s!"private def encode{stem} (resolve : Pgx.Typed.TypeResolver) (value : {use.leanType}) :",
    "    Except Pgx.Typed.Error String := do"
  ] ++ componentEncodeBody ref use ++ [
    "",
    s!"private def decode{stem}Text (resolve : Pgx.Typed.TypeResolver) (value : String) :",
    s!"    Except Pgx.Typed.Error {use.leanType} := do"
  ] ++ componentDecodeTextBody ref use ++ [
    "",
    s!"private def decode{stem}Binary (resolve : Pgx.Typed.TypeResolver) (oid : UInt32)",
    s!"    (value : ByteArray) : Except Pgx.Typed.Error {use.leanType} := do"
  ] ++ componentDecodeBinaryBody ref use ++ [""]

private def emitArray (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.ArrayIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "array declaration")
  let localName := (named.leanType.splitOn ".").getLast!
  let element ← resolveTypeUse plan db value.element.key
  let rejectsNull := typeRejectsNull db value.element.key
  let arrayType := s!"Pgx.Typed.PgArray ({element.leanType})"
  let mut lines := [s!"namespace {localName}", ""]
  if rejectsNull then
    lines := lines ++ [s!"abbrev Data := {arrayType}", ""]
    lines := lines ++ emitValidator "Data" "Value" #[{
      name := s!"{value.key.display} element domain NOT NULL"
      evaluate := ".ok (Pgx.Constraint.arrayElementsNotNull value)"
    }]
  else
    lines := lines ++ [s!"abbrev Value := {arrayType}", ""]
  lines := lines ++ [
    "def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}",
    ""
  ]
  lines := lines ++ emitComponentHelpers "Element" value.element element
  lines := lines ++ [
    "def codec : Pgx.Typed.ResolvedCodec Value where",
    "  expected := descriptor",
    "  encode resolve _ value := do",
    "    let encoded ← Pgx.Typed.fromEncodeStringError <|",
    "      Pgx.Typed.encodeArrayText",
    s!"        (fun element => Pgx.Typed.asStringError (encodeElement resolve element)) \
      {if rejectsNull then "value.val" else "value"}",
    "    pure { format := 0, value := some encoded.toUTF8 }",
    "  decode resolve _ format value := do",
    "    let some bytes := value",
    s!"      | throw (.decode {stringLiteral ("unexpected NULL for array " ++ value.key.display)})",
    "    let decoded ← if format == 0 then",
    "      let some text := String.fromUTF8? bytes",
    s!"        | throw (.decode {stringLiteral ("array text is not UTF-8 for " ++ value.key.display)})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeArrayText",
    "          (fun item => Pgx.Typed.asStringError (decodeElementText resolve item)) text",
    "    else if format == 1 then",
    s!"      let element ← resolve ({typeKeyExpr value.element.key})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeArrayBinary element.oid",
    "          (fun oid item => Pgx.Typed.asStringError",
    "            (decodeElementBinary resolve oid item)) bytes",
    "    else",
    s!"      throw (.decode {stringLiteral ("unsupported wire format for array " ++ value.key.display)})"
  ]
  if rejectsNull then
    lines := lines ++ [
      "    match validate decoded with",
      "    | .ok refined => pure refined",
      "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
    ]
  else
    lines := lines ++ ["    pure decoded"]
  lines := lines ++ ["",
    s!"end {localName}",
    "",
    s!"abbrev {localName} := {localName}.Value",
    ""
  ]
  pure lines

private def emitRange (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.RangeIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "range declaration")
  let localName := (named.leanType.splitOn ".").getLast!
  let subtype ← resolveTypeUse plan db value.subtype.key
  let rangeType := s!"Pgx.Typed.PgRange ({subtype.leanType})"
  let boundCheck? := (typmodCheck? db value.subtype "item" true
      s!"{value.key.display} bound type modifier").map fun check => {
    check with
    evaluate := s!"Pgx.Constraint.evaluateRangeBounds (fun item => {check.evaluate}) value"
  }
  let mut lines := [s!"namespace {localName}", ""]
  match boundCheck? with
  | some check =>
      lines := lines ++ [s!"abbrev Data := {rangeType}", ""]
      lines := lines ++ emitValidator "Data" "Value" #[check]
  | none =>
      lines := lines ++ [s!"abbrev Value := {rangeType}", ""]
  lines := lines ++ [
    "def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}",
    ""
  ]
  lines := lines ++ emitComponentHelpers "Subtype" value.subtype subtype
  lines := lines ++ [
    "def codec : Pgx.Typed.ResolvedCodec Value where",
    "  expected := descriptor",
    "  encode resolve _ value := do",
    "    let encoded ← Pgx.Typed.fromEncodeStringError <|",
    "      Pgx.Typed.encodeRangeText",
    s!"        (fun item => Pgx.Typed.asStringError (encodeSubtype resolve item)) \
      {if boundCheck?.isSome then "value.val" else "value"}",
    "    pure { format := 0, value := some encoded.toUTF8 }",
    "  decode resolve _ format value := do",
    "    let some bytes := value",
    s!"      | throw (.decode {stringLiteral ("unexpected NULL for range " ++ value.key.display)})",
    "    let decoded ← if format == 0 then",
    "      let some text := String.fromUTF8? bytes",
    s!"        | throw (.decode {stringLiteral ("range text is not UTF-8 for " ++ value.key.display)})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeRangeText",
    "          (fun item => Pgx.Typed.asStringError (decodeSubtypeText resolve item)) text",
    "    else if format == 1 then",
    s!"      let subtype ← resolve ({typeKeyExpr value.subtype.key})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeRangeBinary subtype.oid subtype.oid",
    "          (fun oid item => Pgx.Typed.asStringError",
    "            (decodeSubtypeBinary resolve oid item)) bytes",
    "    else",
    s!"      throw (.decode {stringLiteral ("unsupported wire format for range " ++ value.key.display)})"
  ]
  if boundCheck?.isSome then
    lines := lines ++ [
      "    match validate decoded with",
      "    | .ok refined => pure refined",
      "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
    ]
  else
    lines := lines ++ ["    pure decoded"]
  lines := lines ++ ["",
    s!"end {localName}",
    "",
    s!"abbrev {localName} := {localName}.Value",
    ""
  ]
  pure lines

private def emitMultirange (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.MultirangeIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "multirange declaration")
  let some range := db.range? value.range
    | throw (.malformedIR s!"multirange {value.key}" "linked range is absent")
  let localName := (named.leanType.splitOn ".").getLast!
  let subtype ← resolveTypeUse plan db range.subtype.key
  let multirangeType := s!"Pgx.Typed.PgMultirange ({subtype.leanType})"
  let boundCheck? := (typmodCheck? db range.subtype "item" true
      s!"{value.key.display} bound type modifier").map fun check => {
    check with
    evaluate := s!"Pgx.Constraint.evaluateMultirangeBounds (fun item => {check.evaluate}) value"
  }
  let mut lines := [s!"namespace {localName}", ""]
  match boundCheck? with
  | some check =>
      lines := lines ++ [s!"abbrev Data := {multirangeType}", ""]
      lines := lines ++ emitValidator "Data" "Value" #[check]
  | none =>
      lines := lines ++ [s!"abbrev Value := {multirangeType}", ""]
  lines := lines ++ [
    "def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}",
    ""
  ]
  lines := lines ++ emitComponentHelpers "Subtype" range.subtype subtype
  lines := lines ++ [
    "def codec : Pgx.Typed.ResolvedCodec Value where",
    "  expected := descriptor",
    "  encode resolve _ value := do",
    "    let encoded ← Pgx.Typed.fromEncodeStringError <|",
    "      Pgx.Typed.encodeMultirangeText",
    s!"        (fun item => Pgx.Typed.asStringError (encodeSubtype resolve item)) \
      {if boundCheck?.isSome then "value.val" else "value"}",
    "    pure { format := 0, value := some encoded.toUTF8 }",
    "  decode resolve _ format value := do",
    "    let some bytes := value",
    s!"      | throw (.decode {stringLiteral ("unexpected NULL for multirange " ++ value.key.display)})",
    "    let decoded ← if format == 0 then",
    "      let some text := String.fromUTF8? bytes",
    s!"        | throw (.decode {stringLiteral ("multirange text is not UTF-8 for " ++ value.key.display)})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeMultirangeText",
    "          (fun item => Pgx.Typed.asStringError (decodeSubtypeText resolve item)) text",
    "    else if format == 1 then",
    s!"      let subtype ← resolve ({typeKeyExpr range.subtype.key})",
    "      Pgx.Typed.fromDecodeStringError <|",
    "        Pgx.Typed.decodeMultirangeBinary subtype.oid subtype.oid",
    "          (fun oid item => Pgx.Typed.asStringError",
    "            (decodeSubtypeBinary resolve oid item)) bytes",
    "    else",
    s!"      throw (.decode {stringLiteral ("unsupported wire format for multirange " ++ value.key.display)})"
  ]
  if boundCheck?.isSome then
    lines := lines ++ [
      "    match validate decoded with",
      "    | .ok refined => pure refined",
      "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
    ]
  else
    lines := lines ++ ["    pure decoded"]
  lines := lines ++ ["",
    s!"end {localName}",
    "",
    s!"abbrev {localName} := {localName}.Value",
    ""
  ]
  pure lines

private def emitComposite (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.CompositeIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "composite declaration")
  let localName := (named.leanType.splitOn ".").getLast!
  let fieldNames := allocatedNames (value.fields.map (·.name)) "field"
  let mut uses : Array TypeUse := #[]
  for field in value.fields do uses := uses.push (← resolveTypeUse plan db field.ty.key)
  let mut checks : Array GeneratedCheck := #[]
  for i in [0:value.fields.size] do
    let field := value.fields[i]!
    if typeRejectsNull db field.ty.key then
      checks := checks.push {
        name := s!"{value.key.display}.{field.name} domain NOT NULL"
        evaluate := s!".ok (Pgx.Constraint.SqlTruth.isNotNull value.{fieldNames[i]!})"
      }
    if let some check := typmodCheck? db field.ty s!"value.{fieldNames[i]!}" true
        s!"{value.key.display}.{field.name} type modifier" then
      checks := checks.push check
  let refined := !checks.isEmpty
  let mut lines := [s!"namespace {localName}", "", "structure Data where"]
  for i in [0:value.fields.size] do
    lines := lines ++ [s!"  {fieldNames[i]!} : Option ({uses[i]!.leanType})"]
  lines := lines ++ [""]
  if refined then
    lines := lines ++ emitValidator "Data" "Value" checks
  else
    lines := lines ++ ["abbrev Value := Data", ""]
  lines := lines ++ ["def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}", ""]
  for i in [0:value.fields.size] do
    lines := lines ++ emitComponentHelpers s!"Field{i + 1}" value.fields[i]!.ty uses[i]!
  lines := lines ++ [
    "def codec : Pgx.Typed.ResolvedCodec Value where",
    "  expected := descriptor",
    "  encode resolve _ value := do"
  ]
  let valueAccess := if refined then "value.val" else "value"
  for i in [0:value.fields.size] do
    lines := lines ++ [
      s!"    let field{i + 1} ← match {valueAccess}.{fieldNames[i]!} with",
      "      | none => pure none",
      s!"      | some item => some <$> encodeField{i + 1} resolve item"
    ]
  let encodedFields := Array.range value.fields.size |>.map fun i => s!"field{i + 1}"
  lines := lines ++ [
    s!"    let encoded := Pgx.Typed.renderCompositeText {arrayExpr encodedFields}",
    "    pure { format := 0, value := some encoded.toUTF8 }",
    "  decode resolve _ format value := do",
    "    unless format == 0 do",
    s!"      throw (.decode {stringLiteral ("unsupported wire format for composite " ++ value.key.display)})",
    "    let some bytes := value",
    s!"      | throw (.decode {stringLiteral ("unexpected NULL for composite " ++ value.key.display)})",
    "    let some text := String.fromUTF8? bytes",
    s!"      | throw (.decode {stringLiteral ("composite text is not UTF-8 for " ++ value.key.display)})",
    s!"    let fields ← Pgx.Typed.fromDecodeStringError (Pgx.Typed.parseCompositeTextArity {value.fields.size} text)"
  ]
  for i in [0:value.fields.size] do
    lines := lines ++ [
      s!"    let field{i + 1} ← match fields[{i}]! with",
      "      | none => pure none",
      s!"      | some item => some <$> decodeField{i + 1}Text resolve item"
    ]
  let decodedFields := Array.range value.fields.size |>.map fun i =>
    s!"{fieldNames[i]!} := field{i + 1}"
  if refined then
    lines := lines ++ [
      "    let decoded : Data := { " ++ commaSep decodedFields ++ " }",
      "    match validate decoded with",
      "    | .ok refined => pure refined",
      "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
    ]
  else
    lines := lines ++ ["    pure { " ++ commaSep decodedFields ++ " }"]
  lines := lines ++ ["",
    s!"end {localName}",
    "",
    s!"abbrev {localName} := {localName}.Value",
    ""
  ]
  pure lines

private def emitEnum (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.EnumIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "enum declaration")
  let localName := (named.leanType.splitOn ".").getLast!
  let reservedCases := #["mk", "codec", "descriptor", "toLabel", "ofLabel"]
  let mut scope : Scope := { used := reservedCases }
  let mut cases : Array String := #[]
  for label in value.labels do
    let (name, next) := scope.claim (lowerCamel label "value")
    scope := next
    cases := cases.push name
  let mut lines := [s!"inductive {localName} where"]
  for name in cases do lines := lines ++ [s!"  | {name}"]
  lines := lines ++ ["  deriving Repr, BEq, DecidableEq", "", s!"namespace {localName}", ""]
  lines := lines ++ [s!"def toLabel : {localName} → String"]
  for i in [0:value.labels.size] do
    lines := lines ++ [s!"  | .{cases[i]!} => {stringLiteral value.labels[i]!}"]
  lines := lines ++ ["", s!"def ofLabel? : String → Option {localName}"]
  for i in [0:value.labels.size] do
    lines := lines ++ [s!"  | {stringLiteral value.labels[i]!} => some .{cases[i]!}"]
  lines := lines ++ [
    "  | _ => none",
    "",
    "def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}",
    "",
    s!"def codec : Pgx.Typed.ResolvedCodec {localName} where",
    "  expected := descriptor",
    "  encode _ _ value := pure { format := 0, value := some (toLabel value).toUTF8 }",
    "  decode _ _ format value := do",
    s!"    let label ← decodeEnumLabel {stringLiteral value.key.display} format value",
    "    match ofLabel? label with",
    "    | some decoded => pure decoded",
    s!"    | none => throw (.decode ({stringLiteral ("unknown enum label for " ++ value.key.display ++ ": ")} ++ label))",
    "",
    s!"end {localName}",
    ""
  ]
  pure lines

private def emitDomain (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (value : Pgx.DomainIR) : Except CodegenError (List String) := do
  let some named := namedType? plan value.key
    | throw (.unsupportedType value.key "domain declaration")
  let localName := (named.leanType.splitOn ".").getLast!
  let base ← resolveTypeUse plan db value.base.key
  let context := s!"domain {value.key}"
  let scope : ExprScope := {
    domainValue := some {
      sourceName := "VALUE"
      access := "value.toBase"
      declared := { key := value.key }
      storage := value.base
      nullable := false
    }
  }
  let mut checks : Array GeneratedCheck := #[]
  for constraint in value.localConstraints do
    checks := checks.push {
      name := constraint.name
      evaluate := ← compileTruthExpr plan db scope
        s!"{context} constraint {constraint.name}" constraint.expression
    }
  if let some check := typmodCheck? db value.base "value.toBase" false
      s!"{value.key.display} type modifier" then
    checks := checks.push check
  let mut lines := [
    s!"namespace {localName}",
    "",
    "structure Data where",
    s!"  toBase : {base.leanType}",
    ""
  ]
  lines := lines ++ emitValidator "Data" "Value" checks
  lines := lines ++ [
    s!"def toBase (value : Value) : {base.leanType} := value.val.toBase",
    "",
    "def descriptor : Pgx.Typed.StaticTypeDesc :=",
    s!"  {typeDescExpr db value.key}",
    "",
    s!"private def encodeBase (resolve : Pgx.Typed.TypeResolver) (value : {base.leanType}) :",
    "    Except Pgx.Typed.Error Pgx.Typed.EncodedValue := do",
    s!"  let resolved ← resolve ({typeKeyExpr value.base.key})"
  ]
  lines := lines ++ rawEncodeBody base
  lines := lines ++ [
    "",
    s!"private def decodeBase (resolve : Pgx.Typed.TypeResolver) (format : UInt16)",
    s!"    (value : Option ByteArray) : Except Pgx.Typed.Error {base.leanType} := do"
  ]
  lines := lines ++ [s!"  let resolved ← resolve ({typeKeyExpr value.base.key})"]
  lines := lines ++ rawDecodeBody base
  lines := lines ++ [
    "",
    s!"def codec : Pgx.Typed.ResolvedCodec Value where",
    "  expected := descriptor",
    "  encode resolve _ value := encodeBase resolve (toBase value)",
    "  decode resolve _ format value := do",
    "    let decoded ← decodeBase resolve format value",
    "    match validate { toBase := decoded } with",
    "    | .ok refined => pure refined",
    "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)",
    "",
    s!"end {localName}",
    "",
    s!"abbrev {localName} := {localName}.Value",
    ""
  ]
  pure lines

private def emitGeneratedType (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (key : Pgx.TypeKey) : Except CodegenError (List String) := do
  if let some value := db.array? key then
    emitArray plan db value
  else if let some value := db.domain? key then
    emitDomain plan db value
  else if let some value := db.composite? key then
    emitComposite plan db value
  else if let some value := db.range? key then
    emitRange plan db value
  else if let some value := db.multirange? key then
    emitMultirange plan db value
  else
    throw (.unsupportedType key "generated type declaration")

private def emitTypes (plan : NamingPlan) (db : Pgx.DatabaseIR) :
    Except CodegenError String := do
  let importModules := Id.run do
    let mut values : Array String := #[]
    for value in db.typeOverrides do
      if let some moduleName := value.importModule then
        if moduleName != "Pgx.Typed" then values := pushUnique values moduleName
    return sortStrings values
  let mut lines : List String := [generatedHeader]
  for moduleName in importModules do
    lines := lines ++ ["import " ++ moduleName]
  lines := lines ++ [
    "import Pgx.Constraint.Semantics",
    "import Pgx.Typed",
    "",
    s!"namespace {plan.modulePrefix}.Types",
    "",
    "private def decodeEnumLabel (typeName : String) (format : UInt16)",
    "    (value : Option ByteArray) : Except Pgx.Typed.Error String := do",
    "  unless format == 0 || format == 1 do",
    "    throw (.decode (\"unsupported wire format for enum \" ++ typeName))",
    "  let some bytes := value",
    "    | throw (.decode (\"unexpected NULL for enum \" ++ typeName))",
    "  let some label := String.fromUTF8? bytes",
    "    | throw (.decode (\"enum value is not UTF-8 for \" ++ typeName))",
    "  pure label",
    ""
  ]
  for value in db.enums do
    if (db.typeOverride? value.key).isNone then
      lines := lines ++ (← emitEnum plan db value)
  for key in ← orderedGeneratedTypes db do
    lines := lines ++ (← emitGeneratedType plan db key)
  let descriptors := collectTypeKeys db |>.map (typeDescExpr db)
  lines := lines ++ [
    "def staticTypes : Array Pgx.Typed.StaticTypeDesc :=",
    s!"  {arrayExpr descriptors}",
    "",
    s!"end {plan.modulePrefix}.Types"
  ]
  pure (sourceText lines)

private def relationNames (plan : NamingPlan) (key : Pgx.RelationKey) :
    Except CodegenError (String × String) :=
  match plan.relations.find? (fun value => value.key == key) with
  | some value => pure (value.schemaName, value.relationName)
  | none => throw (.malformedIR s!"relation {key}" "missing generated name")

private def emitRelation (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (relation : Pgx.RelationIR) : Except CodegenError (List String) := do
  let (schemaName, relationName) ← relationNames plan relation.key
  let names := allocatedNames (relation.columns.map (·.name)) "column"
  let mut bindings : Array ExprBinding := #[]
  for i in [0:relation.columns.size] do
    let column := relation.columns[i]!
    bindings := bindings.push {
      sourceName := column.name
      access := s!"value.{names[i]!}"
      declared := column.ty
      storage := column.ty
      nullable := column.nullable
    }
  let scope : ExprScope := { columns := bindings }
  let mut checks : Array GeneratedCheck := #[]
  for constraint in db.constraints do
    if constraint.relation == relation.key && constraint.kind == .check then
      let some expression := constraint.localExpression
        | throw (.malformedIR s!"constraint {constraint.name}"
            "validated check has no typed local expression")
      checks := checks.push {
        name := constraint.name
        evaluate := ← compileTruthExpr plan db scope
          s!"relation {relation.key} constraint {constraint.name}" expression
      }
  for i in [0:relation.columns.size] do
    let column := relation.columns[i]!
    if let some check := typmodCheck? db column.ty s!"value.{names[i]!}"
        column.nullable s!"{relation.key.display}.{column.name} type modifier" then
      checks := checks.push check
  let mut lines := [s!"namespace {plan.modulePrefix}.Schema.{schemaName}.{relationName}", ""]
  lines := lines ++ ["structure Data where"]
  for i in [0:relation.columns.size] do
    let column := relation.columns[i]!
    lines := lines ++ [s!"  {names[i]!} : {← fieldType plan db column.ty column.nullable}"]
  lines := lines ++ [""]
  lines := lines ++ emitValidator "Data" "Row" checks
  lines := lines ++ [
    "def descriptor : Pgx.Typed.StaticRelationDesc :=",
    s!"  {staticRelationExpr relation}",
    "",
    s!"end {plan.modulePrefix}.Schema.{schemaName}.{relationName}",
    ""
  ]
  pure lines

private def serverMajorsExpr (db : Pgx.DatabaseIR) : String :=
  let majors := if db.supportedServerMajors.isEmpty then #[db.serverMajor]
    else db.supportedServerMajors
  arrayExpr (majors.map (fun major => toString major))

private def requiredExtensionsExpr (db : Pgx.DatabaseIR) : String :=
  arrayExpr (db.requiredExtensions.map fun value =>
    s!"({stringLiteral value.1}, {stringLiteral value.2})")

private def emitSchema (plan : NamingPlan) (db : Pgx.DatabaseIR) :
    Except CodegenError String := do
  let mut lines : List String := [
    generatedHeader,
    s!"import {plan.modulePrefix}.Types",
    "",
  ]
  for relation in db.relations do lines := lines ++ (← emitRelation plan db relation)
  let relationDescriptors ← db.relations.mapM fun relation => do
    let (schemaName, relationName) ← relationNames plan relation.key
    pure s!"{plan.modulePrefix}.Schema.{schemaName}.{relationName}.descriptor"
  lines := lines ++ [
    s!"namespace {plan.modulePrefix}",
    "",
    "def database : Pgx.Typed.DatabaseDesc := {",
    s!"  canonicalMajor := {db.serverMajor}",
    s!"  serverMajors := {serverMajorsExpr db}",
    s!"  session := {sessionExpr db.session}",
    s!"  types := {plan.modulePrefix}.Types.staticTypes",
    s!"  relations := {arrayExpr relationDescriptors}",
    s!"  views := {arrayExpr (db.views.map viewExpr)}",
    s!"  routines := {arrayExpr (db.routines.map routineExpr)}",
    s!"  requiredExtensions := {requiredExtensionsExpr db}",
    s!"  extensionCodecPackages := {arrayExpr
      (db.extensionCodecPackages.map extensionCodecPackageExpr)}",
    s!"  schemaHash := {stringLiteral db.contractHash}",
    s!"  contractHash := {stringLiteral db.contractHash}",
    "}",
    "",
    "def attach (conn : Pg.Connection) :",
    "    Std.Async.Async (Except Pgx.Typed.Error (Pgx.Typed.CheckedConnection database)) :=",
    "  Pgx.Typed.attach database conn",
    "",
    s!"end {plan.modulePrefix}"
  ]
  pure (sourceText lines)

private def emitConstraints (plan : NamingPlan) (db : Pgx.DatabaseIR) : String :=
  sourceText [
    generatedHeader,
    s!"import {plan.modulePrefix}.Schema",
    "",
    s!"namespace {plan.modulePrefix}.Constraints",
    "",
    "def all : Array Pgx.ConstraintIR :=",
    s!"  {arrayExpr (db.constraints.map constraintExpr)}",
    "",
    "def indexes : Array Pgx.IndexIR :=",
    s!"  {arrayExpr (db.indexes.map indexExpr)}",
    "",
    "def views : Array Pgx.ViewIR :=",
    s!"  {arrayExpr (db.views.map viewExpr)}",
    "",
    "def routines : Array Pgx.RoutineIR :=",
    s!"  {arrayExpr (db.routines.map routineExpr)}",
    "",
    "def extensionCodecPackages : Array Pgx.ExtensionCodecPackageIR :=",
    s!"  {arrayExpr (db.extensionCodecPackages.map extensionCodecPackageExpr)}",
    "",
    s!"end {plan.modulePrefix}.Constraints"
  ]

private def codecExpr (use : TypeUse) (nullable : Bool) : Option String :=
  use.codec.map fun codec => if nullable then s!"({codec}).option" else codec

private def encodeValueExpr (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (ref : Pgx.TypeRef) (nullable : Bool) (value : String) : Except CodegenError String := do
  let use ← resolveTypeUse plan db ref.key
  match codecExpr use nullable with
  | some codec =>
      pure s!"Pgx.Typed.encodeResolved {codec} catalog ({typeRefExpr ref}) {value}"
  | none => pure s!"Pgx.Typed.encodeBuiltin catalog ({typeRefExpr ref}) {value}"

private def decodeValueExpr (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (ref : Pgx.TypeRef) (nullable : Bool) (index : Nat) : Except CodegenError String := do
  let use ← resolveTypeUse plan db ref.key
  let args := s!"catalog ({typeRefExpr ref}) columns[{index}]!.format values[{index}]!"
  match codecExpr use nullable with
  | some codec => pure s!"Pgx.Typed.decodeResolved {codec} {args}"
  | none => pure s!"Pgx.Typed.decodeBuiltin {args}"

private partial def domainChainAux (db : Pgx.DatabaseIR) (key : Pgx.TypeKey)
    (seen : Array Pgx.TypeKey) : Except CodegenError (Array Pgx.DomainIR) := do
  if seen.contains key then throw (.cyclicDomain key)
  let some domain := db.domain? key
    | throw (.malformedIR s!"logical type {key}" "expected a declared domain")
  if (db.typeOverride? key).isSome then
    throw (.unsupportedConstraint s!"logical type {key}"
      "a type override has no generated proof-producing domain validator")
  match db.domain? domain.base.key with
  | none => pure #[domain]
  | some _ =>
      pure (#[domain] ++ (← domainChainAux db domain.base.key (seen.push key)))

private def domainChain (db : Pgx.DatabaseIR) (key : Pgx.TypeKey) :
    Except CodegenError (Array Pgx.DomainIR) :=
  domainChainAux db key #[]

private def refineDomainExpression (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (logical : Pgx.TypeRef) (wireValue context : String) : Except CodegenError String := do
  let chain ← domainChain db logical.key
  let mut lines : List String := ["(do"]
  let mut previous := wireValue
  let mut index := 0
  for domain in chain.reverse do
    let some named := namedType? plan domain.key
      | throw (.unsupportedConstraint context
          s!"domain {domain.key} has no generated validator")
    let refined := s!"refined{index}"
    lines := lines ++ [
      "  let " ++ refined ++ " ← match " ++ named.leanType ++
        ".validate { toBase := " ++ previous ++ " } with",
      "    | .ok accepted => pure accepted",
      "    | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
    ]
    previous := refined
    index := index + 1
  lines := lines ++ [s!"  pure {previous})"]
  pure (String.intercalate "\n" lines)

private def refineLogicalColumnExpression (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (column : Pgx.QueryColumnIR) (wireValue context : String) : Except CodegenError String := do
  let some logical := column.logicalType | pure wireValue
  if column.nullable then
    let refined ← refineDomainExpression plan db logical "present" context
    pure <| String.intercalate "\n" [
      "(do",
      s!"  match {wireValue} with",
      "  | none => pure none",
      "  | some present => some <$> " ++ refined,
      ")"
    ]
  else
    refineDomainExpression plan db logical wireValue context

private def cardinalityName : Pgx.Cardinality → String
  | .execute => "execute"
  | .exactlyOne => "exactlyOne"
  | .zeroOrOne => "zeroOrOne"
  | .many => "many"

private def cardinalityResult : Pgx.Cardinality → String
  | .execute => "Pgx.Typed.CommandResult"
  | .exactlyOne => "Row"
  | .zeroOrOne => "Option Row"
  | .many => "Array Row"

private def cardinalityRunner : Pgx.Cardinality → String
  | .execute => "execute"
  | .exactlyOne => "fetchOne"
  | .zeroOrOne => "fetchOptional"
  | .many => "fetchMany"

private def emitQuery (plan : NamingPlan) (db : Pgx.DatabaseIR)
    (named : NamedQuery) : Except CodegenError String := do
  let query := named.query
  let paramNames := allocatedNames (query.params.map (·.name)) "param"
  let columnNames := allocatedNames (query.columns.map (·.name)) "column"
  let namespaceName := plan.modulePrefix ++ ".Queries." ++ named.moduleName
  let mut bindings : Array ExprBinding := #[]
  for i in [0:query.columns.size] do
    let column := query.columns[i]!
    let logical := column.logicalType.getD column.ty
    bindings := bindings.push {
      sourceName := column.name
      access := s!"value.{columnNames[i]!}"
      declared := logical
      storage := logical
      nullable := column.nullable
    }
  let scope : ExprScope := { columns := bindings }
  let mut checks : Array GeneratedCheck := #[]
  for constraint in query.localConstraints do
    checks := checks.push {
      name := constraint.name
      evaluate := ← compileTruthExpr plan db scope
        s!"query {query.name} constraint {constraint.name}" constraint.expression
    }
  for i in [0:query.columns.size] do
    let column := query.columns[i]!
    if column.logicalType.isNone then
      if let some check := typmodCheck? db column.ty s!"value.{columnNames[i]!}"
          column.nullable s!"query {query.name}.{column.name} type modifier" then
        checks := checks.push check
  let mut lines : List String := [
    generatedHeader,
    s!"import {plan.modulePrefix}.Schema",
    "",
    s!"namespace {namespaceName}",
    "",
    "structure Params where"
  ]
  for i in [0:query.params.size] do
    let param := query.params[i]!
    lines := lines ++ [s!"  {paramNames[i]!} : {← fieldType plan db param.ty param.nullable}"]
  lines := lines ++ ["", "structure RowData where"]
  for i in [0:query.columns.size] do
    let column := query.columns[i]!
    let logical := column.logicalType.getD column.ty
    lines := lines ++ [s!"  {columnNames[i]!} : {← fieldType plan db logical column.nullable}"]
  lines := lines ++ [""]
  lines := lines ++ emitValidator "RowData" "Row" checks
  lines := lines ++ [
    "private def encodeParams",
    s!"    (catalog : Pgx.Typed.ResolvedCatalog {plan.modulePrefix}.database)",
    "    (params : Params) : Except Pgx.Typed.Error Pgx.Typed.EncodedParams := do",
    "  let _ := catalog",
    "  let _ := params"
  ]
  let mut encodedNames : Array String := #[]
  for i in [0:query.params.size] do
    let encodedName := s!"encoded{i}"
    encodedNames := encodedNames.push encodedName
    lines := lines ++ [s!"  let {encodedName} ← {← encodeValueExpr plan db query.params[i]!.ty query.params[i]!.nullable s!"params.{paramNames[i]!}"}"]
  lines := lines ++ [
    "  pure {",
    s!"    values := {arrayExpr (encodedNames.map (· ++ ".value"))}",
    s!"    formats := {arrayExpr (encodedNames.map (· ++ ".format"))}",
    "  }",
    "",
    "private def decodeRow",
    s!"    (catalog : Pgx.Typed.ResolvedCatalog {plan.modulePrefix}.database)",
    "    (columns : Array Pg.Protocol.ColumnDesc)",
    "    (values : Array (Option ByteArray)) : Except Pgx.Typed.Error Row := do",
    "  let _ := catalog",
    s!"  unless columns.size == {query.columns.size} do",
    s!"    throw (.queryDrift \"generated decoder expected {query.columns.size} column descriptors\")",
    s!"  unless values.size == {query.columns.size} do",
    s!"    throw (.queryDrift \"generated decoder expected {query.columns.size} row values\")"
  ]
  let mut decodedNames : Array String := #[]
  for i in [0:query.columns.size] do
    let column := query.columns[i]!
    let wireName := s!"decodedWire{i}"
    lines := lines ++ [s!"  let {wireName} ← {← decodeValueExpr plan db column.ty column.nullable i}"]
    match column.logicalType with
    | none => decodedNames := decodedNames.push wireName
    | some _ =>
        let decodedName := s!"decoded{i}"
        decodedNames := decodedNames.push decodedName
        let refined ← refineLogicalColumnExpression plan db column wireName
          s!"query {query.name} result {column.name}"
        lines := lines ++ [s!"  let {decodedName} ← {refined}"]
  if query.columns.isEmpty then
    lines := lines ++ ["  let rowData : RowData := RowData.mk"]
  else
    let assignments := Array.range query.columns.size |>.map fun i =>
      columnNames[i]! ++ " := " ++ decodedNames[i]!
    lines := lines ++ ["  let rowData : RowData := { " ++ commaSep assignments ++ " }"]
  lines := lines ++ [
    "  match validate rowData with",
    "  | .ok refined => pure refined",
    "  | .error violation => throw (Pgx.Typed.Error.constraintViolation violation)"
  ]
  lines := lines ++ [
    "",
    "def spec :",
    s!"    Pgx.Typed.QuerySpec {plan.modulePrefix}.database Params Row .{cardinalityName query.cardinality} := " ++ "{",
    s!"  name := {stringLiteral query.name}",
    s!"  sql := {stringLiteral query.sql}",
    s!"  contractHash := {stringLiteral query.sqlHash}",
    s!"  params := {arrayExpr (query.params.map paramSpecExpr)}",
    s!"  columns := {arrayExpr (query.columns.map columnSpecExpr)}",
    "  encode := encodeParams",
    "  decode := decodeRow",
    "}",
    "",
    "def run",
    s!"    (conn : Pgx.Typed.CheckedConnection {plan.modulePrefix}.database)",
    s!"    (params : Params) : Std.Async.Async (Except Pgx.Typed.Error ({cardinalityResult query.cardinality})) :=",
    s!"  Pgx.Typed.{cardinalityRunner query.cardinality} spec conn params",
    "",
    s!"end {namespaceName}"
  ]
  pure (sourceText lines)

private def makeSource (path moduleName contents : String) : GeneratedSource :=
  { path, moduleName, contents }

private def emitRoot (plan : NamingPlan) : String :=
  let imports := [
    s!"import {plan.modulePrefix}.Types",
    s!"import {plan.modulePrefix}.Schema",
    s!"import {plan.modulePrefix}.Constraints"
  ] ++ plan.queries.toList.map (fun query =>
    s!"import {plan.modulePrefix}.Queries.{query.moduleName}")
  sourceText ([generatedHeader] ++ imports)

/-- Validate and deterministically emit the complete local-refinement API.

`modulePrefix` is normalized component-by-component to safe Lean module names;
the normalized value is returned in `GeneratedSources.modulePrefix` so a build
rule can diagnose an unexpected spelling if it chooses to require identity.
-/
def emitDatabase (modulePrefix : String) (database : Pgx.DatabaseIR) :
    Except CodegenError GeneratedSources := do
  let db := database.normalize
  validateIR db
  let plan ← buildNamingPlan modulePrefix db
  let typesModule := plan.modulePrefix ++ ".Types"
  let schemaModule := plan.modulePrefix ++ ".Schema"
  let constraintsModule := plan.modulePrefix ++ ".Constraints"
  let types := makeSource (plan.prefixPath ++ "/Types.lean") typesModule (← emitTypes plan db)
  let schema := makeSource (plan.prefixPath ++ "/Schema.lean") schemaModule (← emitSchema plan db)
  let constraints := makeSource (plan.prefixPath ++ "/Constraints.lean") constraintsModule
    (emitConstraints plan db)
  let mut queries : Array GeneratedSource := #[]
  for named in plan.queries do
    let moduleName := plan.modulePrefix ++ ".Queries." ++ named.moduleName
    queries := queries.push <| makeSource
      (plan.prefixPath ++ "/Queries/" ++ named.moduleName ++ ".lean")
      moduleName (← emitQuery plan db named)
  let root := makeSource (plan.prefixPath ++ ".lean") plan.modulePrefix (emitRoot plan)
  pure { modulePrefix := plan.modulePrefix, types, schema, constraints, queries, root }

end Pgx.Codegen
