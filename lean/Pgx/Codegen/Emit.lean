import Pgx.Codegen.ConstraintParser
import Pgx.Codegen.Identifier
import Pgx.Codegen.Projection
import Pgx.Constraint.Semantics
import Pgx.TypeMapping
import Pgx.Typed

/-!
# Pure Lean source emission

`emitDatabase` is deliberately independent of the filesystem and PostgreSQL.
It validates a normalized `DatabaseIR` and returns every declared generated
source as data.  The build rule is responsible only for writing those values
to its declared outputs.
-/

namespace Pgx.Codegen

open Pgx.Codegen.Identifier

inductive CodegenError where
  | invalidModulePrefix (value reason : String)
  | malformedIR (context reason : String)
  | duplicateType (key : Pgx.TypeKey)
  | duplicateRelation (key : Pgx.RelationKey)
  | duplicateQuery (name : String)
  | unsupportedType (key : Pgx.TypeKey) (context : String)
  | unsupportedConstraint (context reason : String)
  | cyclicDomain (key : Pgx.TypeKey)
  | cyclicType (key : Pgx.TypeKey)
  deriving Repr, BEq, Inhabited

namespace CodegenError

def toMessage : CodegenError → String
  | .invalidModulePrefix value reason =>
      s!"invalid generated module prefix {repr value}: {reason}"
  | .malformedIR context reason => s!"invalid {context}: {reason}"
  | .duplicateType key => s!"duplicate PostgreSQL type in generation IR: {key}"
  | .duplicateRelation key => s!"duplicate PostgreSQL relation in generation IR: {key}"
  | .duplicateQuery name => s!"duplicate generated query name: {name}"
  | .unsupportedType key context =>
      s!"unsupported PostgreSQL type {key} while generating {context}"
  | .unsupportedConstraint context reason =>
      s!"unsupported local constraint while generating {context}: {reason}"
  | .cyclicDomain key => s!"cyclic PostgreSQL domain base chain at {key}"
  | .cyclicType key => s!"cyclic generated PostgreSQL type dependency at {key}"

end CodegenError

instance : ToString CodegenError := ⟨CodegenError.toMessage⟩

/-- One generated Lean module and its repository-relative output path. -/
structure GeneratedSource where
  path : String
  moduleName : String
  contents : String
  deriving Repr, BEq, Inhabited

/-- The fixed generated output partition.  Query modules vary only with the
declared query inputs; catalog-discovered objects remain in the three fixed
schema modules. -/
structure GeneratedSources where
  modulePrefix : String
  types : GeneratedSource
  schema : GeneratedSource
  constraints : GeneratedSource
  queries : Array GeneratedSource
  root : GeneratedSource
  deriving Repr, BEq, Inhabited

namespace GeneratedSources

def all (sources : GeneratedSources) : Array GeneratedSource :=
  #[sources.types, sources.schema, sources.constraints] ++ sources.queries ++ #[sources.root]

def findModule? (sources : GeneratedSources) (moduleName : String) : Option GeneratedSource :=
  sources.all.find? (fun source => source.moduleName == moduleName)

end GeneratedSources

private structure NamedType where
  key : Pgx.TypeKey
  leanType : String
  codec : String

private structure NamedSchema where
  source : String
  leanName : String

private structure NamedRelation where
  key : Pgx.RelationKey
  schemaName : String
  relationName : String

private structure NamedQuery where
  query : Pgx.QueryIR
  moduleName : String

private structure LogicalTable where
  relation : Pgx.RelationIR
  names : NamedRelation
  caseName : String

private structure NamedRelationalConstraint where
  constraint : Pgx.ConstraintIR
  declarationName : String
  fieldName : String
  unsupportedReason : Option String := none
  deriving Inhabited

private structure LogicalKeyField where
  sourceName : String
  leanName : String
  rowField : String
  leanType : String

private structure NamingPlan where
  modulePrefix : String
  prefixPath : String
  types : Array NamedType
  schemas : Array NamedSchema
  relations : Array NamedRelation
  queries : Array NamedQuery

private structure TypeUse where
  leanType : String
  codec : Option String := none
  binaryParamConstructor : Option String := none
  resultFormat : UInt16 := 0
  deriving Inhabited

private def generatedHeader : String :=
  "module\n\n/- This file is generated by lean-pgx.  Do not edit it directly. -/"

private def sourceText (lines : List String) : String :=
  String.intercalate "\n" lines ++ "\n"

private def commaSep (values : Array String) : String :=
  String.intercalate ", " values.toList

private def arrayExpr (values : Array String) : String :=
  "#[" ++ commaSep values ++ "]"

private def recordExpr (body : String) : String :=
  "{ " ++ body ++ " }"

private def optionExpr (value : Option String) : String :=
  match value with
  | none => "none"
  | some value => "some (" ++ value ++ ")"

private def boolExpr (value : Bool) : String :=
  if value then "true" else "false"

private def sortStrings (values : Array String) : Array String :=
  values.toList.mergeSort (fun left right => compare left right == .lt) |>.toArray

private def sortTypeKeys (values : Array Pgx.TypeKey) : Array Pgx.TypeKey :=
  values.toList.mergeSort (fun left right =>
    compare left.display right.display == .lt) |>.toArray

private def pushUnique [BEq α] (values : Array α) (value : α) : Array α :=
  if values.contains value then values else values.push value

private def firstDuplicateList? [BEq α] : List α → Option α
  | [] => none
  | value :: rest => if rest.contains value then some value else firstDuplicateList? rest

private def firstDuplicate? [BEq α] (values : Array α) : Option α :=
  firstDuplicateList? values.toList

private def normalizePrefix (value : String) : Except CodegenError (String × String) := do
  if value.isEmpty then
    throw (.invalidModulePrefix value "the prefix is empty")
  let components := value.splitOn "."
  if components.any String.isEmpty then
    throw (.invalidModulePrefix value "empty dot-separated component")
  let components := components.map (fun component => upperCamel component "Generated")
  pure (String.intercalate "." components, String.intercalate "/" components)

private def typeKeyExpr (key : Pgx.TypeKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}, kind := .{key.kind.tag}"

private def typeRefExpr (ref : Pgx.TypeRef) : String :=
  let typmod := ref.typmod.map (fun value => toString value)
  recordExpr s!"key := {typeKeyExpr ref.key}, typmod := {optionExpr typmod}"

private def relationKeyExpr (key : Pgx.RelationKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def columnKeyExpr (key : Pgx.ColumnKey) : String :=
  recordExpr s!"relation := {relationKeyExpr key.relation}, name := {stringLiteral key.name}"

private def collationKeyExpr (key : Pgx.CollationKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def qualifiedNameExpr (key : Pgx.QualifiedName) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def operatorKeyExpr (key : Pgx.OperatorKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}, leftType := {typeKeyExpr key.leftType}, rightType := {typeKeyExpr key.rightType}"

private def constraintKeyExpr (key : Pgx.ConstraintKey) : String :=
  recordExpr s!"relation := {relationKeyExpr key.relation}, name := {stringLiteral key.name}"

private def indexKeyExpr (key : Pgx.IndexKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}"

private def routineKeyExpr (key : Pgx.RoutineKey) : String :=
  recordExpr s!"schema := {stringLiteral key.schema}, name := {stringLiteral key.name}, inputTypes := {arrayExpr (key.inputTypes.map typeRefExpr)}"

private def compositeFieldExpr (field : Pgx.CompositeFieldIR) : String :=
  let collation := optionExpr (field.collation.map collationKeyExpr)
  recordExpr s!"name := {stringLiteral field.name}, ordinal := {field.ordinal}, ty := {typeRefExpr field.ty}, collation := {collation}"

private def typeDescExpr (db : Pgx.DatabaseIR) (key : Pgx.TypeKey) : String :=
  match db.enum? key with
  | some value =>
      let labels := arrayExpr (value.labels.map stringLiteral)
      recordExpr s!"key := {typeKeyExpr key}, enumLabels := {labels}"
  | none =>
      match db.domain? key with
      | some value =>
          recordExpr s!"key := {typeKeyExpr key}, base := some ({typeRefExpr value.base}), notNull := {boolExpr value.notNull}"
      | none =>
          match db.array? key with
          | some value =>
              recordExpr s!"key := {typeKeyExpr key}, arrayElement := some ({typeRefExpr value.element}), arrayDelimiter := some ({stringLiteral value.delimiter})"
          | none =>
              match db.composite? key with
              | some value =>
                  let fields := arrayExpr (value.fields.map compositeFieldExpr)
                  recordExpr s!"key := {typeKeyExpr key}, compositeFields := {fields}"
              | none =>
                  match db.range? key with
                  | some value =>
                      let collation := optionExpr (value.collation.map collationKeyExpr)
                      let canonical := optionExpr (value.canonical.map routineKeyExpr)
                      let subtypeDiff := optionExpr (value.subtypeDiff.map routineKeyExpr)
                      recordExpr s!"key := {typeKeyExpr key}, rangeSubtype := some ({typeRefExpr value.subtype}), rangeMultirange := some ({typeKeyExpr value.multirange}), rangeCollation := {collation}, rangeSubtypeOpclass := some ({qualifiedNameExpr value.subtypeOpclass}), rangeCanonical := {canonical}, rangeSubtypeDiff := {subtypeDiff}"
                  | none =>
                      match db.multirange? key with
                      | some value =>
                          recordExpr s!"key := {typeKeyExpr key}, multirangeRange := some ({typeKeyExpr value.range})"
                      | none => recordExpr s!"key := {typeKeyExpr key}"

private def sessionExpr (session : Pgx.SessionContract) : String :=
  let searchPath := arrayExpr (session.searchPath.map stringLiteral)
  recordExpr s!"searchPath := {searchPath}, timezone := {stringLiteral session.timezone}, encoding := {stringLiteral session.encoding}, standardConformingStrings := {boolExpr session.standardConformingStrings}"

private def staticColumnExpr (column : Pgx.RelationColumnIR) : String :=
  recordExpr s!"name := {stringLiteral column.name}, ordinal := {column.ordinal}, ty := {typeRefExpr column.ty}, nullable := {boolExpr column.nullable}"

