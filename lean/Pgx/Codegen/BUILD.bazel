"""PostgreSQL probe and pure Lean code-generation tools."""

load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_library")

package(default_visibility = ["//visibility:private"])

lean_library(
    name = "identifier",
    srcs = ["Identifier.lean"],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "manifest",
    srcs = ["Manifest.lean"],
    deps = ["//lean/Pgx/IR:json"],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "constraint_parser",
    srcs = ["ConstraintParser.lean"],
    deps = [
        "//lean/Pgx/Constraint:ir",
        "//lean/Pgx:ir",
    ],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "projection",
    srcs = ["Projection.lean"],
    deps = ["//lean/Pgx:ir"],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "probe",
    srcs = ["Probe.lean"],
    deps = [
        ":constraint_parser",
        ":projection",
        "//lean/Pgx/Codegen/Probe:pg17",
        "//lean/Pgx/Codegen/Probe:pg18",
        "//lean/Pgx:type_mapping",
        "@pg_lean//:pg_lean",
    ],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_library(
    name = "emit",
    srcs = ["Emit.lean"],
    deps = [
        ":constraint_parser",
        ":identifier",
        ":projection",
        "//lean/Pgx/Constraint:semantics",
        "//lean/Pgx:pg_typed",
        "//lean/Pgx:type_mapping",
    ],
    strip_module_prefix = "lean",
    visibility = ["//lean:internal"],
)

lean_binary(
    name = "pgx_codegen",
    srcs = ["Main.lean"],
    deps = [
        ":emit",
        ":manifest",
        ":probe",
        "//lean/Pgx/IR:json",
        "@pg_lean//:pg_lean",
    ],
    strip_module_prefix = "lean",
    visibility = ["//visibility:public"],
)

lean_binary(
    name = "pgx_compare",
    srcs = ["Compare.lean"],
    deps = ["//lean/Pgx/IR:json"],
    strip_module_prefix = "lean",
    visibility = ["//visibility:public"],
)
